// Расширение ЧЗ_БезПодписи — только для разработки с эмулятором ЧЗ.
// Работает исключительно при включенном режиме тестового контура ИС МП; в боевом режиме ничего не меняет.

#Область СлужебныйПрограммныйИнтерфейс

// Истина — подписи ИС МП заменяются заглушкой (включен тестовый контур ИС МП).
//
// Возвращаемое значение:
//  Булево
//
Функция ЭЧЗ_РежимБезПодписи() Экспорт

	Возврат ПолучитьФункциональнуюОпцию("РежимРаботыСТестовымКонтуромИСМП") = Истина;

КонецФункции

// Подпись-заглушка вместо CMS: эмулятор ЧЗ подпись не проверяет, ИНН берет из открытого текста.
//
// Параметры:
//  Данные - Строка - что «подписывается».
//
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция ЭЧЗ_ПодписьЗаглушка(Данные) Экспорт

	Возврат ПолучитьДвоичныеДанныеИзСтроки("CHZ-EMULATOR-NO-SIGNATURE " + Строка(Данные));

КонецФункции

#КонецОбласти

#Область ПерехватМетодов

// Если ключа сессии нет и сертификатов для подписания на сервере тоже нет — в тестовом контуре
// запрашиваем ключ с подписью-заглушкой (ГИС МТ, СУЗ, розничный токен).
&Вместо("ОбновитьКлючСессииНаСервере")
Функция ЭЧЗ_ОбновитьКлючСессииНаСервере(ПараметрыЗапроса, ОбновлятьКлючСессииНаСервере = Истина)

	Результат = ПродолжитьВызов(ПараметрыЗапроса, ОбновлятьКлючСессииНаСервере);
	Если Результат Или Не ЭЧЗ_РежимБезПодписи() Тогда
		Возврат Результат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	РезультатЗапроса = ИнтерфейсАвторизацииИСМПВызовСервера.ЗапроситьПараметрыАвторизации(ПараметрыЗапроса);
	Если РезультатЗапроса.ПараметрыАвторизации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ИНН = "";
	ПараметрыЗапроса.Свойство("ИНН", ИНН);
	Подпись = ЭЧЗ_ПодписьЗаглушка(РезультатЗапроса.ПараметрыАвторизации.Данные + " " + ИНН);

	Возврат ЗапроситьУстановитьКлючСессии(
		ПараметрыЗапроса, РезультатЗапроса.ПараметрыАвторизации, Подпись).КлючСессииУстановлен;

КонецФункции

#КонецОбласти
