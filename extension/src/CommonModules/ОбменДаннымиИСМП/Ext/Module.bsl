// Расширение ЧЗ_БезПодписи — только для разработки с эмулятором ЧЗ (тестовый контур ИС МП).

#Область ПерехватМетодов

// Сообщениям, которые ждут подписи, ставится подпись-заглушка — дальше они идут как подписанные
// на сервере: без окна подписания на клиенте и без сертификата.
&Вместо("СообщенияКПередаче")
Функция ЭЧЗ_СообщенияКПередаче(СообщенияJSON, СертификатыДляПодписанияНаСервере, ПараметрыОбмена)

	Если Не ИнтерфейсАвторизацииИСМПСлужебный.ЭЧЗ_РежимБезПодписи() Тогда
		Возврат ПродолжитьВызов(СообщенияJSON, СертификатыДляПодписанияНаСервере, ПараметрыОбмена);
	КонецЕсли;

	Подписанные = Новый Массив;
	Для Каждого СообщениеJSON Из СообщенияJSON Цикл
		Если СообщениеJSON.ТребуетсяПодписание И Не ЗначениеЗаполнено(СообщениеJSON.ТекстОшибки) Тогда
			СвойстваПодписи = Новый Структура("Подпись",
				ИнтерфейсАвторизацииИСМПСлужебный.ЭЧЗ_ПодписьЗаглушка(Строка(СообщениеJSON.Операция)));
			СообщениеJSON.Вставить("СвойстваПодписи", СвойстваПодписи);
			СообщениеJSON.ТребуетсяПодписание = Ложь; // типовая не отправит его на подписание клиенту
			Подписанные.Добавить(СообщениеJSON);
		КонецЕсли;
	КонецЦикла;

	Результат = ПродолжитьВызов(СообщенияJSON, СертификатыДляПодписанияНаСервере, ПараметрыОбмена);

	// Как после подписания на сервере: признак остается, подпись лежит в СвойстваПодписи.
	Для Каждого СообщениеJSON Из Подписанные Цикл
		СообщениеJSON.ТребуетсяПодписание = Истина;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
