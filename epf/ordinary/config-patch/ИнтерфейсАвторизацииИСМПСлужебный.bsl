//ОА++ Эмулятор ЧЗ: если ключ сессии не получен и сертификатов на сервере нет,
// в тестовом контуре ключ запрашивается с подписью-заглушкой.
Функция ОбновитьКлючСессииНаСервере(ПараметрыЗапроса, ОбновлятьКлючСессииНаСервере = Истина) Экспорт

	Результат = ОА_ОбновитьКлючСессииНаСервереТиповая(ПараметрыЗапроса, ОбновлятьКлючСессииНаСервере);
	Если Результат Или Не ОА_РежимБезПодписи() Тогда
		Возврат Результат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	РезультатЗапроса = ИнтерфейсАвторизацииИСМПВызовСервера.ЗапроситьПараметрыАвторизации(ПараметрыЗапроса);
	Если РезультатЗапроса.ПараметрыАвторизации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ИНН = "";
	ПараметрыЗапроса.Свойство("ИНН", ИНН);
	Подпись = ОА_ПодписьЗаглушка(РезультатЗапроса.ПараметрыАвторизации.Данные + " " + ИНН);

	Возврат ЗапроситьУстановитьКлючСессии(
		ПараметрыЗапроса, РезультатЗапроса.ПараметрыАвторизации, Подпись).КлючСессииУстановлен;

КонецФункции

// Возвращает Истина, если подписи ИС МП заменяются заглушкой (включен тестовый контур ИС МП).
Функция ОА_РежимБезПодписи() Экспорт

	Возврат ПолучитьФункциональнуюОпцию("РежимРаботыСТестовымКонтуромИСМП") = Истина;

КонецФункции

// Подпись-заглушка вместо CMS: эмулятор подпись не проверяет, ИНН берет из открытого текста.
// Через временный файл: ПолучитьДвоичныеДанныеИзСтроки недоступна в режиме совместимости 8.2.13.
Функция ОА_ПодписьЗаглушка(Данные) Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла("txt");
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Запись.Записать("CHZ-EMULATOR-NO-SIGNATURE " + Строка(Данные));
	Запись.Закрыть();
	Результат = Новый ДвоичныеДанные(ИмяФайла);
	УдалитьФайлы(ИмяФайла);

	Возврат Результат;

КонецФункции

