//ОА++ Эмулятор ЧЗ: в тестовом контуре ИС МП сообщения получают подпись-заглушку
// и обрабатываются как подписанные на сервере, без сертификата и окна подписания.
Функция СообщенияКПередаче(СообщенияJSON, СертификатыДляПодписанияНаСервере, ПараметрыОбмена) Экспорт

	Если Не ИнтерфейсАвторизацииИСМПСлужебный.ОА_РежимБезПодписи() Тогда
		Возврат ОА_СообщенияКПередачеТиповая(СообщенияJSON, СертификатыДляПодписанияНаСервере, ПараметрыОбмена);
	КонецЕсли;

	Подписанные = Новый Массив;
	Для Каждого СообщениеJSON Из СообщенияJSON Цикл
		Если СообщениеJSON.ТребуетсяПодписание И Не ЗначениеЗаполнено(СообщениеJSON.ТекстОшибки) Тогда
			СвойстваПодписи = Новый Структура("Подпись",
				ИнтерфейсАвторизацииИСМПСлужебный.ОА_ПодписьЗаглушка(Строка(СообщениеJSON.Операция)));
			СообщениеJSON.Вставить("СвойстваПодписи", СвойстваПодписи);
			СообщениеJSON.ТребуетсяПодписание = Ложь;
			Подписанные.Добавить(СообщениеJSON);
		КонецЕсли;
	КонецЦикла;

	Результат = ОА_СообщенияКПередачеТиповая(СообщенияJSON, СертификатыДляПодписанияНаСервере, ПараметрыОбмена);

	Для Каждого СообщениеJSON Из Подписанные Цикл
		СообщениеJSON.ТребуетсяПодписание = Истина;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Было: Функция СообщенияКПередаче(СообщенияJSON, СертификатыДляПодписанияНаСервере, ПараметрыОбмена) Экспорт
Функция ОА_СообщенияКПередачеТиповая(СообщенияJSON, СертификатыДляПодписанияНаСервере, ПараметрыОбмена)
//ОА--
