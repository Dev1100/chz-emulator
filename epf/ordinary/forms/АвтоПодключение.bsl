// ПОДКЛЮЧЕНИЕ

// Компьютер эмулятора по умолчанию - сервер 1С из строки соединения: Srvr="hogwarts" -> hogwarts,
// Srvr="tcp://srv:1541,srv2" -> srv. Для файловой базы - этот компьютер.
Функция АдресЭмулятораПоУмолчанию()

	Строка = СтрокаСоединенияИнформационнойБазы();
	Позиция = Найти(НРег(Строка), "srvr=""");
	Если Позиция = 0 Тогда
		Возврат "127.0.0.1";
	КонецЕсли;
	Сервер = Сред(Строка, Позиция + 6);
	Сервер = Лев(Сервер, Найти(Сервер, """") - 1);
	Если Найти(Сервер, ",") > 0 Тогда
		Сервер = Лев(Сервер, Найти(Сервер, ",") - 1);
	КонецЕсли;
	Если Найти(Сервер, "://") > 0 Тогда
		Сервер = Сред(Сервер, Найти(Сервер, "://") + 3);
	КонецЕсли;
	Если Найти(Сервер, ":") > 0 Тогда
		Сервер = Лев(Сервер, Найти(Сервер, ":") - 1);
	КонецЕсли;
	Сервер = СокрЛП(Сервер);
	Возврат ?(Сервер = "" Или НРег(Сервер) = "localhost", "127.0.0.1", Сервер);

КонецФункции

Процедура ЗаполнитьИНН()
	Организация = Зн("Организация");
	ЭлементыФормы.ИНН.Значение = ?(ЗначениеЗаполнено(Организация), СокрЛП(Организация.ИНН), "");
КонецПроцедуры

// Возвращает Истина, если для применения настроек нужен перезапуск программы.
Функция ПодключитьВыполнить() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("%1. Подключение к эмулятору %2", Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"), АдресЭмулятора()));

	// 1. Эмулятор в сети
	Р = ЗапросКЭмулятору("GET", "/_emu/state?limit=1");
	Если Не Р.Успех Тогда
		Строки.Добавить("1. Эмулятор: не отвечает. " + Р.Текст);
		Строки.Добавить(ПодсказкаЭмуляторНедоступен());
		УстановитьПротокол(СтрСоединить(Строки, Символы.ПС) + Символы.ПС + Символы.ПС + ТекущееСостояние());
		Возврат Ложь;
	КонецЕсли;
	Строки.Добавить("1. Эмулятор: доступен по сети");

	// 2. Корневой сертификат эмулятора на этом компьютере
	Строки.Добавить("2. Сертификат эмулятора на этом компьютере: " + ДоверитьСертификат());

	// 3. Константы
	НуженПерезапуск = Ложь;
	Если Не Константы.ВестиУчетМаркируемойПродукцииИСМП.Получить() Тогда
		Константы.ВестиУчетМаркируемойПродукцииИСМП.Установить(Истина);
		НуженПерезапуск = Истина;
		Строки.Добавить("3. Учет маркируемой продукции ИС МП: включен");
	Иначе
		Строки.Добавить("3. Учет маркируемой продукции ИС МП: уже включен");
	КонецЕсли;
	Если Не Константы.РежимРаботыСТестовымКонтуромИСМП.Получить() Тогда
		Константы.РежимРаботыСТестовымКонтуромИСМП.Установить(Истина);
		НуженПерезапуск = Истина;
		Строки.Добавить("   Тестовый контур ИС МП: включен");
	Иначе
		Строки.Добавить("   Тестовый контур ИС МП: уже включен");
	КонецЕсли;

	// 4. Прокси-сервер
	Строки.Добавить("4. Прокси-сервер: " + ЗаписатьПрокси(Истина));

	// 5. Организация в эмуляторе
	Если ЗначениеЗаполнено(Зн("ИНН")) Тогда
		Строки.Добавить("5. Эмулятор: " + ЗарегистрироватьОрганизациюВЭмуляторе());
	Иначе
		Строки.Добавить("5. Эмулятор: у организации не заполнен ИНН - ключ сессии ИС МП получить не удастся");
	КонецЕсли;

	// 6. Правка конфигурации "без подписи"
	Если Не ЕстьПравкаБезПодписи() Тогда
		Строки.Добавить("6. Правка конфигурации ""без подписи"" не найдена: без электронной подписи организации ключ сессии
			|   не получить. Правку вносит администратор (chz-emulator, ИНСТРУКЦИЯ_НЕ_КА.md, раздел 9).");
	КонецЕсли;

	Если НуженПерезапуск Тогда
		Строки.Добавить("");
		Строки.Добавить("Перезапустите программу и откройте обработку снова: подключение будет проверено.");
		УстановитьПротокол(СтрСоединить(Строки, Символы.ПС) + Символы.ПС + Символы.ПС + ТекущееСостояние());
		Возврат Истина;
	КонецЕсли;

	Строки.Добавить("");
	ДобавитьПроверку(Строки);
	УстановитьПротокол(СтрСоединить(Строки, Символы.ПС) + Символы.ПС + Символы.ПС + ТекущееСостояние());
	Возврат Ложь;

КонецФункции

Процедура ОтключитьВыполнить() Экспорт

	Константы.РежимРаботыСТестовымКонтуромИСМП.Установить(Ложь);
	УстановитьПротокол("Тестовый контур ИС МП: отключен" + Символы.ПС + "Прокси-сервер: " + ЗаписатьПрокси(Ложь)
		+ Символы.ПС + "Перезапустите программу." + Символы.ПС + Символы.ПС + ТекущееСостояние());

КонецПроцедуры

Функция АдресЭмулятора()
	Возврат СокрЛП(Зн("Адрес")) + ":" + Формат(Зн("Порт"), "ЧГ=0");
КонецФункции

Функция ПодсказкаЭмуляторНедоступен()

	Возврат СтрШаблон("   Проверьте на компьютере %1:
		|   - эмулятор запущен с доступом из сети: start.bat --bind 0.0.0.0
		|     (без --bind он принимает соединения только с самого компьютера);
		|   - в брандмауэре Windows разрешены входящие TCP-подключения на порт %2;
		|   - имя ""%1"" разрешается с этого компьютера (иначе укажите IP-адрес);
		|   - код ответа 502/503 обычно означает, что запрос ушел в другой прокси-сервер: на этом компьютере задана
		|     переменная окружения HTTP_PROXY (VPN и т. п.) - добавьте ""%1"" в переменную NO_PROXY и перезапустите 1С.",
		СокрЛП(Зн("Адрес")), Формат(Зн("Порт"), "ЧГ=0"));

КонецФункции

// Настройка прокси-сервера хранится так же, как ее записывает форма БСП "Параметры прокси-сервера": в клиент-серверной
// базе - константа НастройкаПроксиСервера (ее читают и сервер, и толстый клиент), в файловой - общие настройки
// пользователей. Общие настройки записываются в обоих случаях: часть кода читает их напрямую.
Функция ЗаписатьПрокси(Использовать)

	Настройка = Новый Соответствие;
	Настройка.Вставить("ИспользоватьПрокси",                      Использовать);
	Настройка.Вставить("ИспользоватьСистемныеНастройки",          Ложь);
	Настройка.Вставить("Сервер",                                  СокрЛП(Зн("Адрес")));
	Настройка.Вставить("Порт",                                    Зн("Порт"));
	Настройка.Вставить("Пользователь",                            "");
	Настройка.Вставить("Пароль",                                  "");
	Настройка.Вставить("НеИспользоватьПроксиДляЛокальныхАдресов", Ложь);
	Настройка.Вставить("ИспользоватьАутентификациюОС",            Ложь);

	Где = Новый Массив;
	Если Не ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		Константы.НастройкаПроксиСервера.Установить(Новый ХранилищеЗначения(Настройка));
		Где.Добавить("сервер 1С:Предприятия");
	КонецЕсли;

	Количество = 0;
	Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", Настройка, , ПользовательИБ.Имя);
		Количество = Количество + 1;
	КонецЦикла;
	Если Количество = 0 Тогда
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", Настройка);
	КонецЕсли;
	Где.Добавить(СтрШаблон("пользователей: %1", Макс(Количество, 1)));

	Возврат ?(Использовать, АдресЭмулятора(), "отключен") + " (" + СтрСоединить(Где, ", ") + ")";

КонецФункции

Функция ЗарегистрироватьОрганизациюВЭмуляторе()

	ИНН = Зн("ИНН");
	Результат = ЗапросКЭмулятору("POST", "/_emu/participant",
		Новый Структура("inn, name, status", ИНН, Строка(Зн("Организация")), "REGISTERED"));
	Если Результат.Успех Тогда
		ЗапросКЭмулятору("POST", "/_emu/settings", Новый Структура("default_inn", ИНН));
		Возврат "организация зарегистрирована участником оборота, ИНН " + ИНН;
	КонецЕсли;
	Возврат "организацию зарегистрировать не удалось: " + Результат.Текст;

КонецФункции

// Служебные методы эмулятора (/_emu/...) - напрямую, без прокси-сервера.
Функция ЗапросКЭмулятору(Метод, АдресЗапроса, Данные = Неопределено, ИмяФайлаОтвета = "")

	Результат = Новый Структура("Успех, Код, Текст", Ложь, 0, "");
	Попытка
		Соединение = Новый HTTPСоединение(СокрЛП(Зн("Адрес")), Зн("Порт"), , , Новый ИнтернетПрокси(Ложь), 10);
		Запрос = Новый HTTPЗапрос(АдресЗапроса);
		Если Данные <> Неопределено Тогда
			Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			Запись = Новый ЗаписьJSON;
			Запись.УстановитьСтроку();
			ЗаписатьJSON(Запись, Данные);
			Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		Если ИмяФайлаОтвета <> "" Тогда
			Ответ = Соединение.Получить(Запрос, ИмяФайлаОтвета);
		Иначе
			Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
			Результат.Текст = Ответ.ПолучитьТелоКакСтроку();
		КонецЕсли;
		Результат.Код   = Ответ.КодСостояния;
		Результат.Успех = Ответ.КодСостояния = 200;
		Если Не Результат.Успех Тогда
			Результат.Текст = СтрШаблон("код ответа %1%2", Ответ.КодСостояния,
				?(ПустаяСтрока(Результат.Текст), "", ": " + Лев(Результат.Текст, 300)));
		КонецЕсли;
	Исключение
		Результат.Текст = СтрШаблон("эмулятор %1 недоступен (%2)", АдресЭмулятора(),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЕРТИФИКАТ

// HTTPS к ГИС МТ через прокси-сервер эмулятора, как в типовой конфигурации: проверка сертификата по хранилищу Windows.
// Возвращает пустую строку при успехе, иначе текст ошибки.
Функция ОшибкаHTTPSЧерезЭмулятор()

	Попытка
		Прокси = Новый ИнтернетПрокси;
		Прокси.Установить("https", СокрЛП(Зн("Адрес")), Зн("Порт"));
		Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = Ложь;
		Соединение = Новый HTTPСоединение("markirovka.sandbox.crptech.ru", 443, , , Прокси, 20, ЗащищенноеСоединение());
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/api/v3/true-api/auth/key"));
		Если Ответ.КодСостояния = 200 Тогда
			Возврат "";
		КонецЕсли;
		Возврат "код ответа " + Ответ.КодСостояния;
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Объект защищенного соединения библиотеки (если есть), иначе - проверка по корневым сертификатам Windows.
Функция ЗащищенноеСоединение()

	Попытка
		Возврат Вычислить("ОбщегоНазначенияИСПовтИсп.ЗащищенноеСоединение()");
	Исключение
		Возврат Вычислить("Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровWindows)");
	КонецПопытки;

КонецФункции

// Если HTTPS через эмулятор не проходит, корневой сертификат скачивается с эмулятора и ставится в хранилище
// "Доверенные корневые центры сертификации" текущего пользователя Windows (certutil -user, без прав администратора;
// Windows спросит подтверждение установки).
Функция ДоверитьСертификат()

	Ошибка = ОшибкаHTTPSЧерезЭмулятор();
	Если Ошибка = "" Тогда
		Возврат "доверенный";
	КонецЕсли;

	ИмяФайла = КаталогВременныхФайлов() + "chz-emulator-ca.crt";
	Р = ЗапросКЭмулятору("GET", "/_emu/ca.crt", , ИмяФайла);
	Если Не Р.Успех Тогда
		Возврат "не доверенный (" + Ошибка + "), скачать с эмулятора не удалось: " + Р.Текст;
	КонецЕсли;

	КодВозврата = Неопределено;
	Попытка
		ЗапуститьПриложение("certutil -user -addstore Root """ + ИмяФайла + """", КаталогВременныхФайлов(), Истина, КодВозврата);
	Исключение
		Возврат "не доверенный, установить не удалось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Установите вручную файл " + ИмяФайла + " в ""Доверенные корневые центры сертификации"".";
	КонецПопытки;

	Ошибка = ОшибкаHTTPSЧерезЭмулятор();
	Если Ошибка = "" Тогда
		Возврат "установлен в доверенные корневые текущего пользователя";
	КонецЕсли;
	Возврат СтрШаблон("установка не помогла (certutil: %1, HTTPS: %2). Установите вручную файл %3 в ""Доверенные
		|   корневые центры сертификации"" и перезапустите программу.", КодВозврата, Ошибка, ИмяФайла);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОВЕРКА

Процедура ПроверитьВыполнить() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("%1. Проверка подключения к эмулятору %2", Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"), АдресЭмулятора()));
	Р = ЗапросКЭмулятору("GET", "/_emu/state?limit=1");
	Если Р.Успех Тогда
		Строки.Добавить("1. Эмулятор: доступен по сети");
	Иначе
		Строки.Добавить("1. Эмулятор: не отвечает. " + Р.Текст);
		Строки.Добавить(ПодсказкаЭмуляторНедоступен());
	КонецЕсли;
	Ошибка = ОшибкаHTTPSЧерезЭмулятор();
	Строки.Добавить("2. HTTPS к ГИС МТ через эмулятор с этого компьютера: " + ?(Ошибка = "", "работает",
		"ошибка (" + Ошибка + "). Нажмите ""Подключить"" - сертификат эмулятора будет установлен."));
	Строки.Добавить("");
	ДобавитьПроверку(Строки);
	УстановитьПротокол(СтрСоединить(Строки, Символы.ПС) + Символы.ПС + Символы.ПС + ТекущееСостояние());

КонецПроцедуры

// Ключ сессии ГИС МТ: запрос параметров авторизации идет с этого компьютера, получение ключа - с сервера 1С,
// поэтому успех подтверждает обе стороны.
Процедура ДобавитьПроверку(Строки)

	Организация = Зн("Организация");
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Строки.Добавить("Ключ сессии ГИС МТ: не проверен, не выбрана организация");
		Возврат;
	КонецЕсли;
	Если Не Константы.РежимРаботыСТестовымКонтуромИСМП.Получить() Тогда
		Строки.Добавить("Ключ сессии ГИС МТ: не проверен, тестовый контур ИС МП выключен");
		Возврат;
	КонецЕсли;

	Попытка
		Ключ = ИнтерфейсАвторизацииИСМПСлужебный.ПроверитьОбновитьКлючСессии(
			ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ПараметрыЗапросаКлючаСессии(Организация));
		Если Ключ <> Неопределено Тогда
			Строки.Добавить("Ключ сессии ГИС МТ для """ + Организация + """: получен. Подключение к эмулятору работает.");
		Иначе
			Строки.Добавить("Ключ сессии ГИС МТ для """ + Организация + """: не получен. Проверьте журнал на вкладке ""Журнал""
				|веб-интерфейса эмулятора (http://" + АдресЭмулятора() + "/): если запросов auth/simpleSignIn нет,
				|сервер 1С не доверяет сертификату эмулятора или не видит компьютер " + СокрЛП(Зн("Адрес")) + ".");
		КонецЕсли;
	Исключение
		Строки.Добавить("Ключ сессии ГИС МТ: ошибка. " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Правка "без подписи" вносится в конфигурацию (в режиме совместимости 8.2 расширения не подключаются):
// функция ИнтерфейсАвторизацииИСМПСлужебный.ОА_РежимБезПодписи появляется только вместе с ней.
Функция ЕстьПравкаБезПодписи()

	Попытка
		Выполнить("Результат = ИнтерфейсАвторизацииИСМПСлужебный.ОА_РежимБезПодписи();");
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ТекущееСостояние()

	Строки = Новый Массив;
	Строки.Добавить("Состояние базы:");
	Строки.Добавить("  тестовый контур ИС МП: " + ДаНет(Константы.РежимРаботыСТестовымКонтуромИСМП.Получить()));
	Строки.Добавить("  учет маркируемой продукции ИС МП: " + ДаНет(Константы.ВестиУчетМаркируемойПродукцииИСМП.Получить()));
	Если Не ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		Хранилище = Константы.НастройкаПроксиСервера.Получить();
		Строки.Добавить("  прокси-сервер (константа сервера 1С): "
			+ ОписаниеПрокси(?(ТипЗнч(Хранилище) = Тип("ХранилищеЗначения"), Хранилище.Получить(), Неопределено)));
	КонецЕсли;
	Строки.Добавить("  прокси-сервер текущего пользователя: "
		+ ОписаниеПрокси(ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкаПроксиСервера", "")));
	Строки.Добавить("  правка конфигурации ""без подписи"": " + ?(ЕстьПравкаБезПодписи(), "есть", "нет"));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ОписаниеПрокси(Настройка)
	Если ТипЗнч(Настройка) <> Тип("Соответствие") Или Настройка.Получить("ИспользоватьПрокси") <> Истина Тогда
		Возврат "не используется";
	ИначеЕсли Настройка.Получить("ИспользоватьСистемныеНастройки") = Истина Тогда
		Возврат "системные настройки";
	КонецЕсли;
	Возврат СтрШаблон("%1:%2", Настройка.Получить("Сервер"), Формат(Настройка.Получить("Порт"), "ЧГ=0"));
КонецФункции

Функция ДаНет(ЗначениеФлага)
	Возврат ?(ЗначениеФлага = Истина, "да", "нет");
КонецФункции
