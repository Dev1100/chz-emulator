// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ПриОткрытии()

	ПостроитьЭлементы();
	ЭлементыФормы.Адрес.Значение = АдресЭмулятораПоУмолчанию();

	Выборка = Справочники.Организации.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ПометкаУдаления И Не Выборка.ЭтоГруппа Тогда
			ЭлементыФормы.Организация.Значение = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьИНН();

	УстановитьПротокол(ТекущееСостояние());
	Если АвтоматическийРежим <> Ложь Тогда
		ПодключитьОбработчикОжидания("АвтоПодключение", 0.5, Истина);
	КонецЕсли;

КонецПроцедуры

Процедура АвтоПодключение()
	КнопкаПечатьНажатие(Неопределено);
КонецПроцедуры

Процедура ОрганизацияПриИзменении(Элемент)
	ЗаполнитьИНН();
КонецПроцедуры

// Кнопка "Подключить" (в форме-образце - "Печать", имя обработчика сохранено)
Процедура КнопкаПечатьНажатие(Кнопка)

	Если Не ЗначениеЗаполнено(Зн("Адрес")) Тогда
		Предупреждение("Не указан компьютер, на котором запущен эмулятор.");
		Возврат;
	КонецЕсли;
	Состояние("Подключение к эмулятору ЧЗ...");
	Если ПодключитьВыполнить() Тогда
		Предупреждение("Настройки записаны. Тестовый контур и учет ИС МП начнут действовать после перезапуска
			|программы. Откройте обработку снова после перезапуска - подключение будет проверено.");
	КонецЕсли;

КонецПроцедуры

Процедура КнопкаПроверитьНажатие(Кнопка)
	Состояние("Проверка подключения к эмулятору ЧЗ...");
	ПроверитьВыполнить();
КонецПроцедуры

Процедура КнопкаОтключитьНажатие(Кнопка)

	Если Вопрос("Отключить тестовый контур ИС МП и прокси-сервер эмулятора для всех пользователей?",
		РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ОтключитьВыполнить();
	КонецЕсли;

КонецПроцедуры

Процедура КнопкаЗакрытьНажатие(Кнопка)
	Закрыть();
КонецПроцедуры

