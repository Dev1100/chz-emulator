// Автоматическое подключение рабочего места к эмулятору Честного знака, запущенному на другом компьютере сети
// (обычно на сервере 1С). Обычная форма: УТ 10.3, УПП 1.3, КА 1.1 и другие конфигурации обычного приложения на
// библиотеке БГосИС. Только для тестовых баз.
//
// При открытии обработка сама:
//   1) находит эмулятор - по умолчанию на компьютере сервера 1С из строки соединения (Srvr="..."), порт 3128;
//   2) проверяет HTTPS к ГИС МТ через эмулятор и, если корневой сертификат эмулятора не доверен на этом
//      компьютере, скачивает его с эмулятора и ставит в "Доверенные корневые" текущего пользователя Windows;
//   3) включает учет ИС МП и тестовый контур, прописывает прокси-сервер эмулятора (константа сервера 1С и
//      общие настройки всех пользователей), регистрирует организацию участником оборота в эмуляторе;
//   4) получает ключ сессии ГИС МТ (если тестовый контур уже действовал в этом сеансе).
//
// Адрес прокси-сервера - сетевое имя компьютера эмулятора, а не 127.0.0.1: в толстом клиенте часть запросов ИС МП
// выполняется на клиенте (ОбщегоНазначенияИСМП), часть - на сервере 1С (ИнтерфейсАвторизацииИСМПВызовСервера),
// и для клиент-серверной базы обе стороны берут прокси из одной константы НастройкаПроксиСервера.
//
// В макете формы только командная панель (форма-образец), остальные элементы создаются в ПриОткрытии.
// Процедуры с суффиксом Выполнить экспортные: их вызывает автотест.

Перем фЛево, фШирина;
Перем АвтоматическийРежим Экспорт; // Ложь - не запускать подключение при открытии (автотест)

////////////////////////////////////////////////////////////////////////////////
// ПОСТРОЕНИЕ ФОРМЫ

Функция ДобавитьЭлемент(ТипЭлемента, Имя, пЛево, пВерх, пШирина, пВысота)

	Элемент = ЭлементыФормы.Добавить(Тип(ТипЭлемента), Имя, Истина);
	Элемент.Лево   = пЛево;
	Элемент.Верх   = пВерх;
	Элемент.Ширина = пШирина;
	Элемент.Высота = пВысота;
	Возврат Элемент;

КонецФункции

Функция ДобавитьНадпись(Имя, Текст, пЛево, пВерх, пШирина)

	Надпись = ДобавитьЭлемент("Надпись", Имя, пЛево, пВерх, пШирина, 19);
	Надпись.Заголовок = Текст;
	Возврат Надпись;

КонецФункции

Функция ДобавитьПоле(Имя, ТипЗначенияПоля, пЛево, пВерх, пШирина)

	Поле = ДобавитьЭлемент("ПолеВвода", Имя, пЛево, пВерх, пШирина, 19);
	Поле.ТипЗначения = ТипЗначенияПоля;
	Возврат Поле;

КонецФункции

Процедура ПостроитьЭлементы()

	// Элементы формы-образца
	Для Каждого ИмяЭлемента Из СтрРазделить("НадписьСсылкаНаОбъект,СсылкаНаОбъект,Результат", ",") Цикл
		Элемент = ЭлементыФормы.Найти(ИмяЭлемента);
		Если Элемент <> Неопределено Тогда
			ЭлементыФормы.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;

	фЛево = 8;
	фШирина = 684;
	Строка100 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100));

	ДобавитьНадпись("НадписьЭмулятор", "Эмулятор (компьютер):", фЛево, 33, 150);
	Поле = ДобавитьПоле("Адрес", Строка100, 160, 33, 180);
	Поле.Подсказка = "Сетевое имя или IP-адрес компьютера, где запущен эмулятор (по умолчанию - сервер 1С)";
	ДобавитьНадпись("НадписьПорт", "порт:", 350, 33, 40);
	Поле = ДобавитьПоле("Порт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)), 390, 33, 70);
	Поле.Значение = 3128;
	Поле.Формат = "ЧГ=0";

	ДобавитьНадпись("НадписьОрганизация", "Организация:", фЛево, 58, 150);
	Поле = ДобавитьПоле("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), 160, 58, 300);
	Поле.КнопкаВыбора = Истина;
	Поле.УстановитьДействие("ПриИзменении", Новый Действие("ОрганизацияПриИзменении"));
	ДобавитьНадпись("НадписьИНН", "ИНН:", 470, 58, 35);
	Поле = ДобавитьПоле("ИНН", Строка100, 505, 58, фЛево + фШирина - 505);
	Поле.ТолькоПросмотр = Истина;

	ДобавитьНадпись("НадписьПротокол", "Протокол:", фЛево, 83, 150);
	Поле = ДобавитьЭлемент("ПолеВвода", "Протокол", фЛево, 103, фШирина, ЭтаФорма.Высота - 111);
	Поле.ТипЗначения = Новый ОписаниеТипов("Строка");
	Поле.МногострочныйРежим = Истина;
	Поле.ТолькоПросмотр = Истина;
	Поле.УстановитьПривязку(ГраницаЭлементаУправления.Право, ЭтаФорма.Панель, ГраницаЭлементаУправления.Право);
	Поле.УстановитьПривязку(ГраницаЭлементаУправления.Низ, ЭтаФорма.Панель, ГраницаЭлементаУправления.Низ);

	// Командная панель формы-образца: кнопка "Печать" становится кнопкой "Подключить" (обработчик КнопкаПечатьНажатие задан в макете)
	Кнопки = ЭлементыФормы.ДействияФормы.Кнопки;
	Кнопка = Кнопки.Найти("ОсновныеДействияФормыПечать");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Текст = "Подключить";
		Кнопка.Подсказка = "Сертификат, прокси-сервер, тестовый контур ИС МП и проверка подключения к эмулятору";
	КонецЕсли;
	Кнопки.Добавить("Проверить", ТипКнопкиКоманднойПанели.Действие, "Проверить", Новый Действие("КнопкаПроверитьНажатие"));
	Кнопки.Добавить("Отключить", ТипКнопкиКоманднойПанели.Действие, "Отключить эмулятор", Новый Действие("КнопкаОтключитьНажатие"));
	Кнопки.Добавить("Закрыть", ТипКнопкиКоманднойПанели.Действие, "Закрыть", Новый Действие("КнопкаЗакрытьНажатие"));

КонецПроцедуры

Функция Зн(ИмяЭлемента)
	Возврат ЭлементыФормы.Найти(ИмяЭлемента).Значение;
КонецФункции

Процедура УстановитьПротокол(Текст)
	ЭлементыФормы.Протокол.Значение = Текст;
КонецПроцедуры

// Текст протокола для автотеста.
Функция ТекстПротокола() Экспорт
	Возврат ЭлементыФормы.Протокол.Значение;
КонецФункции

