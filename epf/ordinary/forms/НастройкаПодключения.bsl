// ТЕСТОВЫЕ ДАННЫЕ

// Тестовые данные: в 1С - склад, маркируемые товары с видом продукции ИС, GTIN и ТН ВЭД, поставщик и покупатель;
// в эмуляторе - участники, карточки Национального каталога и коды в разных статусах.
// Повторный запуск ничего не дублирует: существующие объекты и коды переиспользуются.
Процедура ЗаполнитьТестовымиДаннымиВыполнить() Экспорт

	Организация = Зн("Организация");
	Строки = Новый Массив;
	Строки.Добавить(Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + ". Тестовые данные для """ + Организация + """ (ИНН " + Зн("ИНН") + ")");

	// Объекты 1С создаются в конфигурациях с регистром Штрихкоды (УПП, УТ 10.3, КА 1.1); в других шаг пропускается,
	// эмулятор заполняется в любом случае.
	Нет = Новый Массив;
	Для Каждого ПолноеИмя Из СтрРазделить("Справочник.Склады,Справочник.КлассификаторЕдиницИзмерения,Справочник.ЕдиницыИзмерения,"
		+ "Справочник.Контрагенты,РегистрСведений.Штрихкоды,Справочник.КлассификаторТНВЭД", ",") Цикл
		Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
			Нет.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяРеквизита Из СтрРазделить("ЕдиницаХраненияОстатков,БазоваяЕдиницаИзмерения,КодТНВЭД", ",") Цикл
		Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Нет.Добавить("реквизит Номенклатура." + ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;

	Товары = ТестовыеТовары();
	Если Нет.Количество() > 0 Тогда
		Строки.Добавить("1С: товары и контрагенты не созданы, в конфигурации нет: " + СтрСоединить(Нет, ", ")
			+ ". Создайте товары вручную со штрихкодами из списка ниже. Коды и карточки в эмуляторе созданы.");
		Для Каждого Товар Из Товары Цикл
			Строки.Добавить("   " + Товар.Наименование + ": штрихкод " + Сред(Товар.GTIN, 2) + " (GTIN " + Товар.GTIN
				+ "), вид продукции """ + СтрЗаменить(Товар.ШаблонВида, "%", "") + """, ТН ВЭД " + Товар.ТНВЭД);
		КонецЦикла;
	Иначе
		ЗаполнитьТестовымиДаннымиВ1С(Строки, Товары);
	КонецЕсли;
	ЗаполнитьТестовымиДаннымиВЭмуляторе(Строки, Товары);
	Строки.Добавить("Полные коды маркировки (с разделителем GS) копируются в веб-интерфейсе эмулятора на вкладке ""Коды"".");
	УстановитьПротокол(СтрСоединить(Строки, Символы.ПС));

КонецПроцедуры

Процедура ЗаполнитьТестовымиДаннымиВ1С(Строки, Товары)

	ИННПоставщика = "7700000002";
	ИННПокупателя = "7700000003";

	ЗагрузитьКлассификаторВидовПродукции(Строки);

	Шт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	Если Шт.Пустая() Тогда
		НоваяЕдиница = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
		НоваяЕдиница.Код = "796";
		НоваяЕдиница.Наименование = "шт";
		НоваяЕдиница.ОбменДанными.Загрузка = Истина;
		НоваяЕдиница.Записать();
		Шт = НоваяЕдиница.Ссылка;
	КонецЕсли;

	Склад = Справочники.Склады.НайтиПоНаименованию("Склад ЧЗ (тест)", Истина);
	Если Склад.Пустая() Тогда
		НовыйСклад = Справочники.Склады.СоздатьЭлемент();
		НовыйСклад.Наименование = "Склад ЧЗ (тест)";
		НовыйСклад.ВидСклада = Перечисления.ВидыСкладов.Оптовый;
		НовыйСклад.ОбменДанными.Загрузка = Истина;
		НовыйСклад.Записать();
		Склад = НовыйСклад.Ссылка;
	КонецЕсли;
	Строки.Добавить("Склад: " + Склад);

	Для Каждого Товар Из Товары Цикл
		ВидПродукции = НайтиВидПродукции(Товар.ШаблонВида);
		Если ВидПродукции = Неопределено Тогда
			Строки.Добавить("Товар """ + Товар.Наименование + """ пропущен: в классификаторе нет вида продукции """
				+ СтрЗаменить(Товар.ШаблонВида, "%", "") + """.");
			Товар.Пропустить = Истина;
			Продолжить;
		КонецЕсли;
		ОтметитьТоварнуюГруппуУчитываемой(ВидПродукции);

		ПоляКлюча = Справочники.КлючиВидовПродукцииИС.ПоляКлюча();
		ПоляКлюча.ВидПродукцииГИСМТ = ВидПродукции;
		КлючВидовПродукции = Справочники.КлючиВидовПродукцииИС.ПолучитьКлюч(ПоляКлюча);

		Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Товар.Наименование, Истина);
		ОбъектНоменклатуры = ?(Номенклатура.Пустая(), Справочники.Номенклатура.СоздатьЭлемент(), Номенклатура.ПолучитьОбъект());
		ОбъектНоменклатуры.Наименование            = Товар.Наименование;
		ОбъектНоменклатуры.НаименованиеПолное      = Товар.Наименование;
		ОбъектНоменклатуры.Артикул                 = "ЧЗ-" + Товар.ТоварнаяГруппа;
		ОбъектНоменклатуры.БазоваяЕдиницаИзмерения = Шт;
		ОбъектНоменклатуры.КодТНВЭД                = КодТНВЭД(Товар.ТНВЭД, Товар.Наименование);
		Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("КлючВидовПродукции") <> Неопределено Тогда
			ОбъектНоменклатуры.КлючВидовПродукции = КлючВидовПродукции;
		КонецЕсли;
		ОбъектНоменклатуры.ОбменДанными.Загрузка = Истина;
		ОбъектНоменклатуры.Записать();

		// Единица хранения остатков подчинена номенклатуре: создается после записи элемента.
		Если Не ЗначениеЗаполнено(ОбъектНоменклатуры.ЕдиницаХраненияОстатков) Тогда
			Единица = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
			Единица.Владелец                = ОбъектНоменклатуры.Ссылка;
			Единица.Наименование            = "шт";
			Единица.ЕдиницаПоКлассификатору = Шт;
			Единица.Коэффициент             = 1;
			Единица.ОбменДанными.Загрузка = Истина;
			Единица.Записать();
			ОбъектНоменклатуры.ЕдиницаХраненияОстатков = Единица.Ссылка;
			ОбъектНоменклатуры.ЕдиницаДляОтчетов       = Единица.Ссылка;
			ОбъектНоменклатуры.Записать();
		КонецЕсли;

		Описание = ОбщегоНазначенияИС.ИнициализироватьДанныеОписанияНоменклатуры();
		Описание.Номенклатура       = ОбъектНоменклатуры.Ссылка;
		Описание.КлючВидовПродукции = КлючВидовПродукции;
		РегистрыСведений.ОписаниеНоменклатурыИС.УстановитьОписание(Описание);

		Строки.Добавить(СтрШаблон("Товар: %1, вид продукции %2, штрихкод %3, ТН ВЭД %4", ОбъектНоменклатуры.Ссылка, ВидПродукции,
			ЗаписатьШтрихкод(Сред(Товар.GTIN, 2), ОбъектНоменклатуры), Товар.ТНВЭД));
	КонецЦикла;

	Строки.Добавить("Поставщик: " + ТестовыйКонтрагент(ИННПоставщика, "ООО Поставщик ЧЗ", Ложь));
	Строки.Добавить("Покупатель: " + ТестовыйКонтрагент(ИННПокупателя, "ООО Покупатель ЧЗ", Истина));

КонецПроцедуры

// Модуль набора записей Штрихкоды в УПП отказывает в записи штрихкода, у которого уже есть владелец (даже при замене),
// поэтому существующая запись проверяется заранее.
Функция ЗаписатьШтрихкод(ЗначениеШтрихкода, ОбъектНоменклатуры)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Владелец ИЗ РегистрСведений.Штрихкоды ГДЕ Штрихкод = &Штрихкод");
	Запрос.УстановитьПараметр("Штрихкод", ЗначениеШтрихкода);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Владелец = ОбъектНоменклатуры.Ссылка Тогда
			Возврат ЗначениеШтрихкода + " (был ранее)";
		КонецЕсли;
		Возврат ЗначениеШтрихкода + " (не записан: принадлежит """ + Выборка.Владелец + """)";
	КонецЕсли;

	Штрихкод = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
	Штрихкод.Штрихкод         = ЗначениеШтрихкода;
	Штрихкод.Владелец         = ОбъектНоменклатуры.Ссылка;
	Штрихкод.ТипШтрихкода     = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
	Штрихкод.ЕдиницаИзмерения = ОбъектНоменклатуры.ЕдиницаХраненияОстатков;
	Штрихкод.Записать();
	Возврат ЗначениеШтрихкода;

КонецФункции

// Классификатор видов продукции ИС заполняется из макета библиотеки (без интернета), если он пуст.
Процедура ЗагрузитьКлассификаторВидовПродукции(Строки)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыПродукцииИС ГДЕ НЕ ПометкаУдаления И НЕ Предопределенный");
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	Состояние("Загрузка классификатора видов продукции ИС (около минуты)...");
	НачатьТранзакцию();
	Попытка
		Результат = ОбщегоНазначенияИС.ПервоначальноеЗаполнениеКлассификаторовВидовПродукции(Истина, Истина);
		Если Результат.УспешнаяЗагрузка Тогда
			ЗафиксироватьТранзакцию();
			Строки.Добавить("Классификатор видов продукции ИС: загружен из макета");
		Иначе
			ОтменитьТранзакцию();
			Строки.Добавить("Классификатор видов продукции ИС: не загружен. " + Результат.СообщениеОбОшибке);
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		Строки.Добавить("Классификатор видов продукции ИС: не загружен. " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция НайтиВидПродукции(Шаблон)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыПродукцииИС
		|ГДЕ Наименование ПОДОБНО &Шаблон И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Наименование");
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Товарная группа учитывается, если для нее есть запись элемента "Виды продукции ГИС МТ" (как в панели администрирования ИС МП).
Процедура ОтметитьТоварнуюГруппуУчитываемой(ВидПродукции)

	Элемент = Справочники.ЭлементыКонструктораВидовПродукцииИС.ВидыПродукцииГИСМТ;
	Набор = РегистрыСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС.СоздатьНаборЗаписей();
	Набор.Отбор.ЭлементКонструктора.Установить(Элемент);
	Набор.Отбор.ВидПродукции.Установить(ВидПродукции);
	Набор.Прочитать();
	Если Набор.Количество() > 0 И Не Набор[0].ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	Набор.Очистить();
	Запись = Набор.Добавить();
	Запись.ЭлементКонструктора = Элемент;
	Запись.ВидПродукции        = ВидПродукции;
	Набор.Записать();

КонецПроцедуры

Процедура ЗаполнитьТестовымиДаннымиВЭмуляторе(Строки, Товары)

	ИНН = Зн("ИНН");
	ИННПоставщика = "7700000002";
	ИННПокупателя = "7700000003";
	Проверка = ЗапросКЭмулятору("GET", "/_emu/state?limit=1");
	Если Не Проверка.Успех Тогда
		Строки.Добавить("Эмулятор: " + Проверка.Текст + ". Коды и карточки Национального каталога не созданы.");
		Возврат;
	КонецЕсли;
	ЗапросКЭмулятору("POST", "/_emu/settings", Новый Структура("default_inn", ИНН));
	ЗапросКЭмулятору("POST", "/_emu/participant", Новый Структура("inn, name", ИНН, Строка(Зн("Организация"))));
	ЗапросКЭмулятору("POST", "/_emu/participant", Новый Структура("inn, name", ИННПоставщика, "ООО Поставщик ЧЗ"));
	ЗапросКЭмулятору("POST", "/_emu/participant", Новый Структура("inn, name", ИННПокупателя, "ООО Покупатель ЧЗ"));
	Для Каждого Товар Из Товары Цикл
		Если Товар.Пропустить Тогда
			Продолжить;
		КонецЕсли;
		ЗапросКЭмулятору("POST", "/_emu/nk", Новый Структура("gtin, name, pg, inn, tnved, brand, status",
			Товар.GTIN, Товар.Наименование, Товар.ТоварнаяГруппа, ИНН, Товар.ТНВЭД, "ТЕСТ", "published"));
		Строки.Добавить(Товар.Наименование + " (" + Товар.GTIN + "):");
		Строки.Добавить("   в обороте: " + КодыВЭмуляторе(Товар, ИНН, "INTRODUCED", 5, Ложь));
		Строки.Добавить("   нанесены, ожидают ввода в оборот: " + КодыВЭмуляторе(Товар, ИНН, "APPLIED", 3, Ложь));
		Строки.Добавить("   в коробе: " + КодыВЭмуляторе(Товар, ИНН, "INTRODUCED", 3, Истина));
		Строки.Добавить("   входящая отгрузка от поставщика: " + ВходящаяОтгрузка(Товар, ИННПоставщика));
	КонецЦикла;

КонецПроцедуры

Функция ТестовыеТовары()

	Товары = Новый Массив;
	// Наименование, ТГ эмулятора, ТН ВЭД, шаблон вида продукции ИС, номер для GTIN 04607777000NN
	Для Каждого Описание Из СтрРазделить(
		"Ботинки мужские тестовые ЧЗ;shoes;6403990000;%Обувн%;1|"
		+ "Футболка хлопковая тестовая ЧЗ;lp;6109100000;Одежда;2|"
		+ "Вода питьевая 0,5 л тестовая ЧЗ;water;2201101100;%Питьевая вода%;3|"
		+ "Туалетная вода тестовая ЧЗ;chemistry;3303009000;Парфюмерия;4", "|") Цикл
		Части = СтрРазделить(Описание, ";");
		Тело = "46077770000" + Части[4];
		Товар = Новый Структура("Наименование, ТоварнаяГруппа, ТНВЭД, ШаблонВида, GTIN, Пропустить",
			Части[0], Части[1], Части[2], Части[3], "0" + Тело + КонтрольнаяЦифраGTIN(Тело), Ложь);
		Товары.Добавить(Товар);
	КонецЦикла;
	Возврат Товары;

КонецФункции

Функция КонтрольнаяЦифраGTIN(Тело)
	Сумма = 0;
	Вес = 3;
	Для Индекс = 0 По СтрДлина(Тело) - 1 Цикл
		Сумма = Сумма + Число(Сред(Тело, СтрДлина(Тело) - Индекс, 1)) * Вес;
		Вес = 4 - Вес;
	КонецЦикла;
	Возврат Строка((10 - Сумма % 10) % 10);
КонецФункции

Функция КодТНВЭД(Код, Наименование)
	Ссылка = Справочники.КлассификаторТНВЭД.НайтиПоКоду(Код);
	Если Ссылка.Пустая() Тогда
		Элемент = Справочники.КлассификаторТНВЭД.СоздатьЭлемент();
		Элемент.Код = Код;
		Элемент.Наименование = Наименование;
		Элемент.ОбменДанными.Загрузка = Истина;
		Элемент.Записать();
		Ссылка = Элемент.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ТестовыйКонтрагент(ИННКонтрагента, Наименование, ЭтоПокупатель)

	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИННКонтрагента);
	Если Контрагент.Пустая() Тогда
		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйКонтрагент.Наименование       = Наименование;
		НовыйКонтрагент.НаименованиеПолное = Наименование;
		НовыйКонтрагент.ИНН                = ИННКонтрагента;
		НовыйКонтрагент.КПП                = "770001001";
		НовыйКонтрагент.ЮрФизЛицо          = Перечисления.ЮрФизЛицо.ЮрЛицо;
		НовыйКонтрагент.Покупатель         = ЭтоПокупатель;
		НовыйКонтрагент.Поставщик          = Не ЭтоПокупатель;
		НовыйКонтрагент.ОбменДанными.Загрузка = Истина;
		НовыйКонтрагент.Записать();
		Контрагент = НовыйКонтрагент.Ссылка;
	КонецЕсли;
	Возврат Строка(Контрагент) + " (ИНН " + ИННКонтрагента + ")";

КонецФункции

// Коды в эмуляторе: если подходящие по GTIN, статусу и владельцу уже есть, используются они, иначе создаются.
Функция КодыВЭмуляторе(Товар, Владелец, Статус, Количество, ВКоробке)

	Есть = 0;
	Ответ = ЗапросКЭмулятору("GET", "/_emu/state?limit=5000&q=" + Товар.GTIN);
	Данные = ?(Ответ.Успех, ПрочитатьОтветJSON(Ответ.Текст), Неопределено);
	Если Данные <> Неопределено Тогда
		Для Каждого Код Из Данные["codes"] Цикл
			Если Код["gtin"] = Товар.GTIN И Код["status"] = Статус И Код["owner_inn"] = Владелец
				И ЗначениеЗаполнено(Код["parent"]) = ВКоробке И Код["package_type"] = "UNIT" Тогда
				Есть = Есть + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Есть >= Количество Тогда
		Возврат СтрШаблон("%1 (созданы ранее)", Есть);
	КонецЕсли;
	ПараметрыКодов = Новый Структура("gtin, pg, name, tnved, owner_inn, count, status, aggregate",
		Товар.GTIN, Товар.ТоварнаяГруппа, Товар.Наименование, Товар.ТНВЭД, Владелец, Количество - Есть, Статус, ВКоробке);
	Ответ = ЗапросКЭмулятору("POST", "/_emu/codes", ПараметрыКодов);
	Если Не Ответ.Успех Тогда
		Возврат "ошибка: " + Ответ.Текст;
	КонецЕсли;
	Данные = ПрочитатьОтветJSON(Ответ.Текст);
	Возврат СтрШаблон("%1 создано%2", Количество - Есть,
		?(ВКоробке И Данные <> Неопределено, ", короб " + Данные["box"], ""));

КонецФункции

Функция ВходящаяОтгрузка(Товар, ИННПоставщика)

	Ответ = ЗапросКЭмулятору("GET", "/_emu/state?limit=5000&q=" + Товар.GTIN);
	Данные = ?(Ответ.Успех, ПрочитатьОтветJSON(Ответ.Текст), Неопределено);
	Если Данные <> Неопределено Тогда
		Для Каждого Код Из Данные["codes"] Цикл
			Если Код["gtin"] = Товар.GTIN И Код["owner_inn"] = ИННПоставщика Тогда
				Возврат "создана ранее (коды у поставщика " + ИННПоставщика + ")";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Ответ = ЗапросКЭмулятору("POST", "/_emu/incoming", Новый Структура("sender_inn, receiver_inn, gtin, pg, count",
		ИННПоставщика, Зн("ИНН"), Товар.GTIN, Товар.ТоварнаяГруппа, 4));
	Данные = ?(Ответ.Успех, ПрочитатьОтветJSON(Ответ.Текст), Неопределено);
	Возврат ?(Данные = Неопределено, "ошибка: " + Ответ.Текст, "документ " + Данные["number"] + ", кодов: 4 (примите документ в 1С)");

КонецФункции

Функция ПрочитатьОтветJSON(Текст)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Возврат ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции
