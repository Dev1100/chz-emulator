// Настройка информационной базы на работу с эмулятором Честного знака. Обычная форма: УПП 1.3, УТ 10.3, КА 1.1 и другие
// конфигурации обычного приложения на библиотеке БГосИС. Только для тестовых баз: включает тестовый контур ИС МП,
// прокси-сервер на эмулятор и подключение к СУЗ.
//
// В макете формы только командная панель (форма-образец), остальные элементы создаются в ПриОткрытии.
// Модуль формы и модуль объекта - одно пространство имен. Процедуры с суффиксом Выполнить экспортные:
// их вызывает автотест (форма открывается без диалогов).

Перем фЛево, фШирина;

////////////////////////////////////////////////////////////////////////////////
// ПОСТРОЕНИЕ ФОРМЫ

Функция ДобавитьЭлемент(ТипЭлемента, Имя, пЛево, пВерх, пШирина, пВысота)

	Элемент = ЭлементыФормы.Добавить(Тип(ТипЭлемента), Имя, Истина);
	Элемент.Лево   = пЛево;
	Элемент.Верх   = пВерх;
	Элемент.Ширина = пШирина;
	Элемент.Высота = пВысота;
	Возврат Элемент;

КонецФункции

Функция ДобавитьНадпись(Имя, Текст, пЛево, пВерх, пШирина)

	Надпись = ДобавитьЭлемент("Надпись", Имя, пЛево, пВерх, пШирина, 19);
	Надпись.Заголовок = Текст;
	Возврат Надпись;

КонецФункции

Функция ДобавитьПоле(Имя, ТипЗначенияПоля, пЛево, пВерх, пШирина)

	Поле = ДобавитьЭлемент("ПолеВвода", Имя, пЛево, пВерх, пШирина, 19);
	Поле.ТипЗначения = ТипЗначенияПоля;
	Возврат Поле;

КонецФункции

Функция ДобавитьФлажок(Имя, Текст, пЛево, пВерх, пШирина)

	Флажок = ДобавитьЭлемент("Флажок", Имя, пЛево, пВерх, пШирина, 19);
	Флажок.Заголовок = Текст;
	Флажок.Значение = Истина;
	Возврат Флажок;

КонецФункции

Процедура ПостроитьЭлементы()

	// Элементы формы-образца
	Для Каждого ИмяЭлемента Из СтрРазделить("НадписьСсылкаНаОбъект,СсылкаНаОбъект,Результат", ",") Цикл
		Элемент = ЭлементыФормы.Найти(ИмяЭлемента);
		Если Элемент <> Неопределено Тогда
			ЭлементыФормы.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;

	фЛево = 8;
	фШирина = 684;
	Строка100 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100));

	ДобавитьНадпись("НадписьЭмулятор", "Эмулятор (адрес):", фЛево, 33, 150);
	Поле = ДобавитьПоле("Адрес", Строка100, 160, 33, 140);
	Поле.Значение = "127.0.0.1";
	ДобавитьНадпись("НадписьПорт", "порт:", 310, 33, 40);
	Поле = ДобавитьПоле("Порт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)), 350, 33, 70);
	Поле.Значение = 3128;
	Поле.Формат = "ЧГ=0";

	ДобавитьНадпись("НадписьОрганизация", "Организация:", фЛево, 58, 150);
	Поле = ДобавитьПоле("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), 160, 58, 300);
	Поле.КнопкаВыбора = Истина;
	Поле.УстановитьДействие("ПриИзменении", Новый Действие("ОрганизацияПриИзменении"));
	ДобавитьНадпись("НадписьИНН", "ИНН:", 470, 58, 35);
	Поле = ДобавитьПоле("ИНН", Строка100, 505, 58, фЛево + фШирина - 505);
	Поле.ТолькоПросмотр = Истина;

	ДобавитьНадпись("НадписьПодразделение", "Произв. объект СУЗ:", фЛево, 83, 150);
	Поле = ДобавитьПоле("Подразделение", ТипПроизводственногоОбъекта(), 160, 83, 300);
	Поле.КнопкаВыбора = Истина;
	Поле.Подсказка = "Подразделение организации, которое станет производственным объектом СУЗ";

	ДобавитьФлажок("ВключитьТестовыйКонтур", "Включить тестовый контур ИС МП", фЛево, 108, 330);
	ДобавитьФлажок("ВключитьУчетИСМП", "Включить учет маркируемой продукции ИС МП", 350, 108, 340);
	ДобавитьФлажок("ЗарегистрироватьВЭмуляторе", "Зарегистрировать организацию в эмуляторе", фЛево, 129, 330);
	ДобавитьФлажок("НастроитьСУЗ", "Настроить подключение к СУЗ для организации", 350, 129, 340);

	ДобавитьНадпись("НадписьИдентификаторСУЗ", "СУЗ, OMS ID:", фЛево, 154, 150);
	Поле = ДобавитьПоле("ИдентификаторСУЗ", Строка100, 160, 154, 140);
	Поле.Значение = "emu-oms-0001";
	ДобавитьНадпись("НадписьАдресСУЗ", "адрес СУЗ:", 310, 154, 75);
	Поле = ДобавитьПоле("АдресСУЗ", Строка100, 390, 154, фЛево + фШирина - 390);
	Поле.Значение = "suz.sandbox.crptech.ru";

	ДобавитьНадпись("НадписьПрокси", "Прокси-сервер:", фЛево, 179, 150);
	Поле = ДобавитьПоле("ПроксиДля", Строка100, 160, 179, 300);
	Поле.КнопкаВыбора = Истина;
	Поле.РежимВыбораИзСписка = Истина;
	Поле.СписокВыбора.Добавить(ПроксиТекущемуПользователю());
	Поле.СписокВыбора.Добавить(ПроксиВсемПользователям());
	Поле.СписокВыбора.Добавить(ПроксиНаСервере());
	Поле.СписокВыбора.Добавить(ПроксиНеНастраивать());
	Поле.Значение = ?(ОбщегоНазначения.ИнформационнаяБазаФайловая(), ПроксиВсемПользователям(), ПроксиНаСервере());

	ДобавитьНадпись("НадписьПротокол", "Протокол:", фЛево, 204, 150);
	Поле = ДобавитьЭлемент("ПолеВвода", "Протокол", фЛево, 224, фШирина, ЭтаФорма.Высота - 232);
	Поле.ТипЗначения = Новый ОписаниеТипов("Строка");
	Поле.МногострочныйРежим = Истина;
	Поле.ТолькоПросмотр = Истина;
	Поле.УстановитьПривязку(ГраницаЭлементаУправления.Право, ЭтаФорма.Панель, ГраницаЭлементаУправления.Право);
	Поле.УстановитьПривязку(ГраницаЭлементаУправления.Низ, ЭтаФорма.Панель, ГраницаЭлементаУправления.Низ);

	// Командная панель формы-образца: кнопка "Печать" становится кнопкой "Настроить" (обработчик КнопкаПечатьНажатие задан в макете)
	Кнопки = ЭлементыФормы.ДействияФормы.Кнопки;
	Кнопка = Кнопки.Найти("ОсновныеДействияФормыПечать");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Текст = "Настроить";
		Кнопка.Подсказка = "Включить тестовый контур и учет ИС МП, прописать прокси-сервер, подключить СУЗ";
	КонецЕсли;
	Кнопки.Добавить("Проверить", ТипКнопкиКоманднойПанели.Действие, "Проверить подключение", Новый Действие("КнопкаПроверитьНажатие"));
	Кнопки.Добавить("ТестовыеДанные", ТипКнопкиКоманднойПанели.Действие, "Заполнить тестовыми данными", Новый Действие("КнопкаТестовыеДанныеНажатие"));
	Кнопки.Добавить("Отключить", ТипКнопкиКоманднойПанели.Действие, "Отключить эмулятор", Новый Действие("КнопкаОтключитьНажатие"));
	Кнопки.Добавить("Закрыть", ТипКнопкиКоманднойПанели.Действие, "Закрыть", Новый Действие("КнопкаЗакрытьНажатие"));

КонецПроцедуры

// Тип производственного объекта СУЗ берется из измерения регистра: в УПП это Подразделения,
// в КА - Структура предприятия.
Функция ТипПроизводственногоОбъекта()

	Регистр = Метаданные.РегистрыСведений.Найти("НастройкиОбменаСУЗ");
	Если Регистр <> Неопределено И Регистр.Измерения.Найти("ПроизводственныйОбъект") <> Неопределено Тогда
		Возврат Регистр.Измерения.ПроизводственныйОбъект.Тип;
	КонецЕсли;
	Возврат Новый ОписаниеТипов("СправочникСсылка.Подразделения");

КонецФункции

Функция Зн(ИмяЭлемента)
	Возврат ЭлементыФормы.Найти(ИмяЭлемента).Значение;
КонецФункции

Процедура УстановитьПротокол(Текст)
	ЭлементыФормы.Протокол.Значение = Текст;
КонецПроцедуры

// Текст протокола для автотеста.
Функция ТекстПротокола() Экспорт
	Возврат ЭлементыФормы.Протокол.Значение;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ПриОткрытии()

	ПостроитьЭлементы();

	Выборка = Справочники.Организации.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ПометкаУдаления И Не Выборка.ЭтоГруппа Тогда
			ЭлементыФормы.Организация.Значение = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьИНН();

	УстановитьПротокол(ТекущееСостояние());

КонецПроцедуры

Процедура ОрганизацияПриИзменении(Элемент)
	ЗаполнитьИНН();
КонецПроцедуры

// Кнопка "Настроить" (в форме-образце - "Печать", имя обработчика сохранено)
Процедура КнопкаПечатьНажатие(Кнопка)

	Если Не ЗначениеЗаполнено(Зн("Организация")) Тогда
		Предупреждение("Поле ""Организация"" не заполнено.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Зн("ИНН")) Тогда
		Предупреждение("У организации не заполнен ИНН: без него ИС МП не выдаст ключ сессии.");
		Возврат;
	КонецЕсли;
	Если Зн("НастроитьСУЗ") И Не ЗначениеЗаполнено(Зн("Подразделение")) Тогда
		Предупреждение("Поле ""Произв. объект СУЗ"" не заполнено. Подразделение указывается как производственный объект СУЗ
			|(или снимите флажок ""Настроить подключение к СУЗ"").");
		Возврат;
	КонецЕсли;

	Если НастроитьВыполнить() Тогда
		Предупреждение("Настройки записаны. Учет маркируемой продукции и тестовый контур ИС МП
			|начнут действовать после перезапуска программы.");
	КонецЕсли;

КонецПроцедуры

Процедура КнопкаПроверитьНажатие(Кнопка)
	ПроверитьВыполнить();
КонецПроцедуры

Процедура КнопкаТестовыеДанныеНажатие(Кнопка)

	Если Не ЗначениеЗаполнено(Зн("Организация")) Тогда
		Предупреждение("Поле ""Организация"" не заполнено.");
		Возврат;
	КонецЕсли;
	Состояние("Заполнение тестовыми данными...");
	ЗаполнитьТестовымиДаннымиВыполнить();

КонецПроцедуры

Процедура КнопкаОтключитьНажатие(Кнопка)

	Если Вопрос("Отключить тестовый контур ИС МП и прокси-сервер эмулятора?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ОтключитьВыполнить();
	КонецЕсли;

КонецПроцедуры

Процедура КнопкаЗакрытьНажатие(Кнопка)
	Закрыть();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// НАСТРОЙКА

Процедура ЗаполнитьИНН()
	Организация = Зн("Организация");
	ЭлементыФормы.ИНН.Значение = ?(ЗначениеЗаполнено(Организация), Организация.ИНН, "");
КонецПроцедуры

// Возвращает Истина, если для применения настроек нужен перезапуск программы.
Функция НастроитьВыполнить() Экспорт

	Организация = Зн("Организация");
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("%1. Настройка для ""%2"" (ИНН %3)", Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"), Организация, Зн("ИНН")));
	НуженПерезапуск = Ложь;

	Если Зн("ВключитьУчетИСМП") И Не Константы.ВестиУчетМаркируемойПродукцииИСМП.Получить() Тогда
		Константы.ВестиУчетМаркируемойПродукцииИСМП.Установить(Истина);
		НуженПерезапуск = Истина;
		Строки.Добавить("Учет маркируемой продукции ИС МП: включен");
	КонецЕсли;

	Если Зн("ВключитьТестовыйКонтур") И Не Константы.РежимРаботыСТестовымКонтуромИСМП.Получить() Тогда
		Константы.РежимРаботыСТестовымКонтуромИСМП.Установить(Истина);
		НуженПерезапуск = Истина;
		Строки.Добавить("Тестовый контур ИС МП: включен");
	КонецЕсли;

	Строки.Добавить("Прокси-сервер: " + ЗаписатьПрокси(Истина));

	Если Зн("ЗарегистрироватьВЭмуляторе") Тогда
		Строки.Добавить("Эмулятор: " + ЗарегистрироватьОрганизациюВЭмуляторе());
	КонецЕсли;

	Если Зн("НастроитьСУЗ") Тогда
		Если ТипПроизводственногоОбъекта().СодержитТип(ТипЗнч(Зн("Подразделение"))) И ЗначениеЗаполнено(Зн("Подразделение")) Тогда
			Строки.Добавить("СУЗ: " + ЗаписатьНастройкуСУЗ());
		Иначе
			Строки.Добавить("СУЗ: не настроен, не указан производственный объект СУЗ.");
		КонецЕсли;
	КонецЕсли;

	УстановитьПротокол(СтрСоединить(Строки, Символы.ПС) + Символы.ПС + Символы.ПС + ТекущееСостояние());
	Возврат НуженПерезапуск;

КонецФункции

Процедура ОтключитьВыполнить() Экспорт

	Константы.РежимРаботыСТестовымКонтуромИСМП.Установить(Ложь);
	УстановитьПротокол("Тестовый контур ИС МП: отключен" + Символы.ПС + "Прокси-сервер: " + ЗаписатьПрокси(Ложь)
		+ Символы.ПС + "Перезапустите программу." + Символы.ПС + Символы.ПС + ТекущееСостояние());

КонецПроцедуры

// Настройка прокси-сервера хранится так же, как ее записывает форма БСП "Параметры прокси-сервера":
// в файловой базе - в общих настройках пользователя, в клиент-серверной - в константе НастройкаПроксиСервера.
Функция ЗаписатьПрокси(Использовать)

	ПроксиДля = Зн("ПроксиДля");
	Если ПроксиДля = ПроксиНеНастраивать() Тогда
		Возврат "не изменялся";
	КонецЕсли;

	Настройка = Новый Соответствие;
	Настройка.Вставить("ИспользоватьПрокси",                      Использовать);
	Настройка.Вставить("ИспользоватьСистемныеНастройки",          Ложь);
	Настройка.Вставить("Сервер",                                  СокрЛП(Зн("Адрес")));
	Настройка.Вставить("Порт",                                    Зн("Порт"));
	Настройка.Вставить("Пользователь",                            "");
	Настройка.Вставить("Пароль",                                  "");
	Настройка.Вставить("НеИспользоватьПроксиДляЛокальныхАдресов", Ложь);
	Настройка.Вставить("ИспользоватьАутентификациюОС",            Ложь);

	Действие = ?(Использовать, СтрШаблон("%1:%2", СокрЛП(Зн("Адрес")), Формат(Зн("Порт"), "ЧГ=0")), "отключен");

	Если ПроксиДля = ПроксиНаСервере() Тогда
		Константы.НастройкаПроксиСервера.Установить(Новый ХранилищеЗначения(Настройка));
		Возврат Действие + " (на сервере 1С:Предприятия)";
	КонецЕсли;

	Если ПроксиДля = ПроксиВсемПользователям() Тогда
		Имена = Новый Массив;
		Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", Настройка, , ПользовательИБ.Имя);
			Имена.Добавить(ПользовательИБ.Имя);
		КонецЦикла;
		Если Имена.Количество() = 0 Тогда
			ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", Настройка);
			Имена.Добавить("<пользователи не заданы>");
		КонецЕсли;
		Возврат Действие + " (пользователи: " + СтрСоединить(Имена, ", ") + ")";
	КонецЕсли;

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", Настройка);
	Возврат Действие + " (текущий пользователь)";

КонецФункции

Функция ЗаписатьНастройкуСУЗ()

	ИдентификаторСУЗ = СокрЛП(Зн("ИдентификаторСУЗ"));
	Станция = Справочники.СтанцииУправленияЗаказамиИСМП.НайтиПоРеквизиту("Идентификатор", ИдентификаторСУЗ);
	Если Станция.Пустая() Тогда
		НоваяСтанция = Справочники.СтанцииУправленияЗаказамиИСМП.СоздатьЭлемент();
		НоваяСтанция.Наименование  = "Эмулятор ЧЗ (" + ИдентификаторСУЗ + ")";
		НоваяСтанция.Идентификатор = ИдентификаторСУЗ;
		НоваяСтанция.ФорматОбмена  = Перечисления.ВерсииФорматаОбменаСУЗ.V3;
		НоваяСтанция.Записать();
		Станция = НоваяСтанция.Ссылка;
	КонецЕсли;

	Запись = РегистрыСведений.НастройкиОбменаСУЗ.СоздатьМенеджерЗаписи();
	Запись.Организация               = Зн("Организация");
	Запись.СтанцияУправленияЗаказами = Станция;
	Запись.ПроизводственныйОбъект    = Зн("Подразделение");
	Запись.Прочитать();

	Запись.Организация               = Зн("Организация");
	Запись.СтанцияУправленияЗаказами = Станция;
	Запись.ПроизводственныйОбъект    = Зн("Подразделение");
	Запись.Адрес                     = СокрЛП(Зн("АдресСУЗ"));
	Запись.Порт                      = 443;
	Запись.Таймаут                   = 60;
	Запись.ИспользоватьЗащищенноеСоединение = Истина;
	Запись.ОбменНаСервере            = Истина;
	Если Запись.ПолучатьКодовЗаИтерацию = 0 Тогда
		Запись.ПолучатьКодовЗаИтерацию = 1000;
	КонецЕсли;
	Если Запись.МаксимальноеКоличествоКодовВЗаказе = 0 Тогда
		Запись.МаксимальноеКоличествоКодовВЗаказе = 150000;
	КонецЕсли;
	// Идентификатор соединения в ИС МП выдается при регистрации рабочего места, эмулятор принимает любой.
	Если Не ЗначениеЗаполнено(Запись.ИдентификаторСоединения) Тогда
		Запись.ИдентификаторСоединения = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Запись.ПроизводственныйОбъектАдресСтрокой) Тогда
		Запись.ПроизводственныйОбъектАдресСтрокой = "Адрес МОД (эмулятор ЧЗ)";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Запись.КодФИАС) Тогда
		Запись.КодФИАС = Новый УникальныйИдентификатор;
	КонецЕсли;
	Запись.Записать();

	Возврат СтрШаблон("станция ""%1"", %2:443, производственный объект ""%3""", Станция, Запись.Адрес, Зн("Подразделение"));

КонецФункции

// Регистрирует организацию участником оборота через служебный метод эмулятора, без прокси-сервера.
Функция ЗарегистрироватьОрганизациюВЭмуляторе()

	ИНН = Зн("ИНН");
	Данные = Новый Структура("inn, name, status", ИНН, Строка(Зн("Организация")), "REGISTERED");
	Результат = ЗапросКЭмулятору("POST", "/_emu/participant", Данные);
	Если Результат.Успех Тогда
		ЗапросКЭмулятору("POST", "/_emu/settings", Новый Структура("default_inn", ИНН));
		Возврат "организация зарегистрирована участником, ИНН по умолчанию " + ИНН;
	КонецЕсли;
	Возврат "не удалось: " + Результат.Текст;

КонецФункции

Функция ЗапросКЭмулятору(Метод, АдресЗапроса, Данные = Неопределено)

	Результат = Новый Структура("Успех, Код, Текст", Ложь, 0, "");
	Попытка
		// к эмулятору без прокси-сервера
		Соединение = Новый HTTPСоединение(СокрЛП(Зн("Адрес")), Зн("Порт"), , , Новый ИнтернетПрокси(Ложь), 10);
		Запрос = Новый HTTPЗапрос(АдресЗапроса);
		Если Данные <> Неопределено Тогда
			Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			Запись = Новый ЗаписьJSON;
			Запись.УстановитьСтроку();
			ЗаписатьJSON(Запись, Данные);
			Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
		Результат.Код   = Ответ.КодСостояния;
		Результат.Текст = Ответ.ПолучитьТелоКакСтроку();
		Результат.Успех = Ответ.КодСостояния = 200;
	Исключение
		Результат.Текст = СтрШаблон("Эмулятор %1:%2 недоступен (%3)", Зн("Адрес"), Формат(Зн("Порт"), "ЧГ=0"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОВЕРКА

Процедура ПроверитьВыполнить() Экспорт

	Организация = Зн("Организация");
	Строки = Новый Массив;
	Строки.Добавить(Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + ". Проверка подключения");

	Р = ЗапросКЭмулятору("GET", "/_emu/state?limit=1");
	Строки.Добавить("1. Эмулятор: " + ?(Р.Успех, "запущен (" + Зн("Адрес") + ":" + Формат(Зн("Порт"), "ЧГ=0") + ")", "не отвечает. " + Р.Текст));

	// Запрос выполняется так же, как в типовой конфигурации: прокси-сервер из настроек БСП, HTTPS с проверкой сертификата по хранилищу Windows.
	ПараметрыHTTP = ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ПараметрыОтправкиHTTPЗапросов(Неопределено, Истина);
	АдресЗапроса = "api/v3/true-api/auth/key";
	Ответ = ОбменДаннымиИСМПКлиентСервер.ОбработатьРезультатОтправкиHTTPЗапросаКакJSON(
		ОбщегоНазначенияИСМП.ПолучитьДанныеИзСервиса(АдресЗапроса, Неопределено, ПараметрыHTTP));
	Если Ответ.ОтветПолучен И Ответ.КодСостояния = 200 Тогда
		Строки.Добавить("2. ГИС МТ (" + ПараметрыHTTP.Сервер + "): подключение по HTTPS через прокси-сервер установлено, сертификат эмулятора доверенный");
	Иначе
		Строки.Добавить("2. ГИС МТ (" + ПараметрыHTTP.Сервер + "): ошибка. "
			+ ОбщегоНазначенияИСКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(АдресЗапроса, Ответ)
			+ Символы.ПС + "   Проверьте, что эмулятор запущен, прокси-сервер настроен, а корневой сертификат эмулятора (ca.crt) установлен в доверенные.");
	КонецЕсли;

	Если ЗначениеЗаполнено(Организация) Тогда
		Ключ = ИнтерфейсАвторизацииИСМПСлужебный.ПроверитьОбновитьКлючСессии(
			ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ПараметрыЗапросаКлючаСессии(Организация));
		Строки.Добавить("3. Ключ сессии ГИС МТ для """ + Организация + """: " + ?(Ключ = Неопределено,
			"не получен. Требуется электронная подпись организации или правка конфигурации ""без подписи"" (см. ИНСТРУКЦИЯ_НЕ_КА.md)", "получен"));

		НастройкиСУЗ = ИнтеграцияИСМП.НастройкиОбменаСУЗ(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация));
		Строки.Добавить("4. Подключение к СУЗ: " + ?(НастройкиСУЗ.БезНастроек.Найти(Организация) = Неопределено,
			"настроено", "не настроено. Установите флажок ""Настроить подключение к СУЗ для организации"" и нажмите ""Настроить"""));
	КонецЕсли;

	УстановитьПротокол(СтрСоединить(Строки, Символы.ПС) + Символы.ПС + Символы.ПС + ТекущееСостояние());

КонецПроцедуры

// Правка "без подписи" вносится в конфигурацию вручную (в режиме совместимости 8.2 расширения не подключаются):
// функция ИнтерфейсАвторизацииИСМПСлужебный.ОА_РежимБезПодписи появляется только вместе с ней.
Функция ЕстьПравкаБезПодписи()

	Попытка
		Выполнить("Результат = ИнтерфейсАвторизацииИСМПСлужебный.ОА_РежимБезПодписи();");
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ТекущееСостояние()

	Строки = Новый Массив;
	Строки.Добавить("Состояние базы:");
	Строки.Добавить("  тестовый контур ИС МП: " + ДаНет(Константы.РежимРаботыСТестовымКонтуромИСМП.Получить()));
	Строки.Добавить("  учет маркируемой продукции ИС МП: " + ДаНет(Константы.ВестиУчетМаркируемойПродукцииИСМП.Получить()));

	Прокси = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкаПроксиСервера", "");
	Строки.Добавить("  прокси-сервер текущего пользователя: " + ОписаниеПрокси(Прокси));
	Хранилище = Константы.НастройкаПроксиСервера.Получить();
	Строки.Добавить("  прокси-сервер на сервере 1С:Предприятия: "
		+ ОписаниеПрокси(?(ТипЗнч(Хранилище) = Тип("ХранилищеЗначения"), Хранилище.Получить(), Неопределено)));

	Строки.Добавить("  правка конфигурации ""без подписи"": " + ?(ЕстьПравкаБезПодписи(), "есть",
		"нет (без электронной подписи ключ сессии ИС МП не получить, см. ИНСТРУКЦИЯ_НЕ_КА.md)"));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ОписаниеПрокси(Настройка)
	Если ТипЗнч(Настройка) <> Тип("Соответствие") Или Настройка.Получить("ИспользоватьПрокси") <> Истина Тогда
		Возврат "не используется";
	ИначеЕсли Настройка.Получить("ИспользоватьСистемныеНастройки") = Истина Тогда
		Возврат "системные настройки";
	КонецЕсли;
	Возврат СтрШаблон("%1:%2", Настройка.Получить("Сервер"), Формат(Настройка.Получить("Порт"), "ЧГ=0"));
КонецФункции

Функция ДаНет(ЗначениеФлага)
	Возврат ?(ЗначениеФлага = Истина, "да", "нет");
КонецФункции

Функция ПроксиТекущемуПользователю()
	Возврат "Для текущего пользователя";
