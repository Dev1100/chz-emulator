// Автотест обработок эмулятора ЧЗ на обычных формах. Запуск: test/run.ps1 (толстый клиент, /Execute этой обработки).
// Параметр запуска: <файл результата>|<каталог с ЭЧЗ_*_ОФ.epf>|<имя подразделения для СУЗ>.
// Открывает обе формы, вызывает их экспортные процедуры (те же, что у кнопок), сверяет протоколы и завершает работу.

Перем тИтоги;

Процедура Проверка(Имя, Условие, Подробности)
	тИтоги.Добавить(?(Условие, "OK   ", "FAIL ") + Имя + ?(Условие, "", ": " + СтрЗаменить(Подробности, Символы.ПС, " / ")));
КонецПроцедуры

Функция ОткрытьФормуОбработки(Каталог, ИмяОбработки)
	Обработка = ВнешниеОбработки.Создать(Каталог + "\" + ИмяОбработки + ".epf", Ложь);
	Форма = Обработка.ПолучитьФорму("Форма");
	Форма.Открыть();
	Возврат Форма;
КонецФункции

Процедура ТестНастройки(Каталог, ИмяПодразделения)

	Форма = ОткрытьФормуОбработки(Каталог, "ЭЧЗ_НастройкаПодключения_ОФ");
	Протокол = Форма.ТекстПротокола();
	Проверка("настройка: форма открыта, состояние базы", СтрНайти(Протокол, "Состояние базы") > 0, Протокол);
	Проверка("настройка: организация с ИНН подставлена", ЗначениеЗаполнено(Форма.ЭлементыФормы.ИНН.Значение), "ИНН пуст");

	Форма.ЭлементыФормы.Подразделение.Значение = Справочники.Подразделения.НайтиПоНаименованию(ИмяПодразделения, Истина);
	Форма.НастроитьВыполнить();
	Протокол = Форма.ТекстПротокола();
	Проверка("настройка: прокси записан", СтрНайти(Протокол, "Прокси-сервер: 127.0.0.1:3128") > 0, Протокол);
	Проверка("настройка: организация в эмуляторе", СтрНайти(Протокол, "зарегистрирована участником") > 0, Протокол);
	Проверка("настройка: СУЗ", СтрНайти(Протокол, "СУЗ: станция") > 0, Протокол);

	Форма.ПроверитьВыполнить();
	Протокол = Форма.ТекстПротокола();
	Проверка("проверка: эмулятор запущен", СтрНайти(Протокол, "1. Эмулятор: запущен") > 0, Протокол);
	Проверка("проверка: HTTPS через прокси", СтрНайти(Протокол, "подключение по HTTPS через прокси-сервер установлено") > 0, Протокол);
	Проверка("проверка: ключ сессии ГИС МТ", СтрНайти(Протокол, """: получен") > 0, Протокол);
	Проверка("проверка: подключение к СУЗ", СтрНайти(Протокол, "4. Подключение к СУЗ: настроено") > 0, Протокол);

	// Двойной прогон: второй не должен ничего дублировать и падать на существующих штрихкодах.
	Для Прогон = 1 По 2 Цикл
		Форма.ЗаполнитьТестовымиДаннымиВыполнить();
		Протокол = Форма.ТекстПротокола();
		Проверка("тестовые данные, прогон " + Прогон + ": 4 товара", СтрЧислоВхождений(Протокол, "Товар: ") = 4, Протокол);
		Проверка("тестовые данные, прогон " + Прогон + ": коды в эмуляторе", СтрЧислоВхождений(Протокол, "в обороте: ") = 4, Протокол);
	КонецЦикла;
	Проверка("тестовые данные, повтор: штрихкоды не дублируются", СтрЧислоВхождений(Протокол, "(был ранее)") = 4, Протокол);
	Проверка("тестовые данные, повтор: коды не дублируются", СтрЧислоВхождений(Протокол, "созданы ранее") >= 12, Протокол);

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.Номенклатура ГДЕ Наименование ПОДОБНО ""%тестов% ЧЗ""");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Проверка("тестовые данные: номенклатура без дублей", Выборка.Количество = 4, "товаров: " + Выборка.Количество);

	Форма.Закрыть();

КонецПроцедуры

Процедура ТестВыгрузкиНК(Каталог)

	Форма = ОткрытьФормуОбработки(Каталог, "ЭЧЗ_ВыгрузкаВНК_ОФ");
	Форма.ЗаполнитьВыполнить();
	Таблица = Форма.ТаблицаТоваров();
	Тестовые = 0;
	Для Каждого СтрокаТоваров Из Таблица Цикл
		Если СтрНайти(СтрокаТоваров.Наименование, "тестов") > 0 И СтрокаТоваров.Выгрузить И Не ЗначениеЗаполнено(СтрокаТоваров.Проблема)
			И СтрДлина(СтрокаТоваров.GTIN) = 14 И ЗначениеЗаполнено(СтрокаТоваров.ТоварнаяГруппа) Тогда
			Тестовые = Тестовые + 1;
		КонецЕсли;
	КонецЦикла;
	Проверка("НК: заполнены 4 тестовых GTIN с товарной группой", Тестовые = 4, Форма.ТекстПротокола());

	Форма.ВыгрузитьВыполнить();
	Протокол = Форма.ТекстПротокола();
	Проверка("НК: выгрузка в эмулятор", СтрНайти(Протокол, "Выгружено карточек в Национальный каталог эмулятора") > 0, Протокол);

	Форма.ЭлементыФормы.ТолькоМаркируемые.Значение = Ложь;
	Форма.ЭлементыФормы.ВидПродукции.Значение = Справочники.ВидыПродукцииИС.НайтиПоНаименованию("Обувные товары", Истина);
	Форма.ЗаполнитьВыполнить();
	Проверка("НК: отбор по виду продукции", Форма.ТаблицаТоваров().Количество() = 1, Форма.ТекстПротокола());

	Форма.Закрыть();

КонецПроцедуры

Процедура Выполнить_Автотест()

	тИтоги = Новый Массив;
	Параметры = СтрРазделить(ПараметрЗапуска, "|");
	ФайлРезультата = Параметры[0];
	Каталог = Параметры[1];
	ИмяПодразделения = ?(Параметры.Количество() > 2, Параметры[2], "Первый этаж");

	Попытка
		ТестНастройки(Каталог, ИмяПодразделения);
	Исключение
		Проверка("настройка: исключение", Ложь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		ТестВыгрузкиНК(Каталог);
	Исключение
		Проверка("НК: исключение", Ложь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Ошибок = 0;
	Для Каждого Итог Из тИтоги Цикл
		Если СтрНачинаетсяС(Итог, "FAIL") Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	тИтоги.Добавить(СтрШаблон("ИТОГ: проверок %1, ошибок %2", тИтоги.Количество(), Ошибок));

	Запись = Новый ЗаписьТекста(ФайлРезультата, КодировкаТекста.UTF8);
	Запись.Записать(СтрСоединить(тИтоги, Символы.ПС));
	Запись.Закрыть();

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

Выполнить_Автотест();
