// Автотест обработки ЭЧЗ_АвтоПодключение_ОФ. Запуск: test/run_auto.ps1 (толстый клиент, /Execute этой обработки).
// Параметр запуска: <файл результата>|<каталог с ЭЧЗ_АвтоПодключение_ОФ.epf>|<ожидаемый компьютер эмулятора>.
// База клиент-серверная, эмулятор запущен с --bind 0.0.0.0, сертификат доверен, правка "без подписи" внесена.

Перем тИтоги;

Процедура Проверка(Имя, Условие, Подробности)
	тИтоги.Добавить(?(Условие, "OK   ", "FAIL ") + Имя + ?(Условие, "", ": " + СтрЗаменить(Подробности, Символы.ПС, " / ")));
КонецПроцедуры

Функция ПроксиКонстанты()
	Хранилище = Константы.НастройкаПроксиСервера.Получить();
	Настройка = ?(ТипЗнч(Хранилище) = Тип("ХранилищеЗначения"), Хранилище.Получить(), Неопределено);
	Если ТипЗнч(Настройка) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Настройка.Получить("Сервер")) + ":" + Формат(Настройка.Получить("Порт"), "ЧГ=0");
КонецФункции

Процедура ТестПодключения(Каталог, Компьютер)

	Обработка = ВнешниеОбработки.Создать(Каталог + "\ЭЧЗ_АвтоПодключение_ОФ.epf", Ложь);
	Форма = Обработка.ПолучитьФорму("Форма");
	Форма.АвтоматическийРежим = Ложь;
	Форма.Открыть();
	Эл = Форма.ЭлементыФормы;
	Проверка("компьютер эмулятора из строки соединения", НРег(Эл.Адрес.Значение) = НРег(Компьютер), Эл.Адрес.Значение);
	Проверка("организация с ИНН подставлена", ЗначениеЗаполнено(Эл.ИНН.Значение), "ИНН пуст");
	Протокол = Форма.ТекстПротокола();
	Проверка("состояние базы", СтрНайти(Протокол, "правка конфигурации ""без подписи"": есть") > 0, Протокол);

	// Недоступный компьютер: подключение прерывается до записи настроек
	ПроксиДо = ПроксиКонстанты();
	Эл.Адрес.Значение = "chz-no-such-host";
	Форма.ПодключитьВыполнить();
	Протокол = Форма.ТекстПротокола();
	Проверка("недоступный эмулятор: сообщение и подсказка", СтрНайти(Протокол, "1. Эмулятор: не отвечает") > 0
		И СтрНайти(Протокол, "--bind 0.0.0.0") > 0, Протокол);
	Проверка("недоступный эмулятор: прокси не изменен", ПроксиКонстанты() = ПроксиДо, ПроксиКонстанты());

	// Штатное подключение
	Эл.Адрес.Значение = Компьютер;
	НуженПерезапуск = Форма.ПодключитьВыполнить();
	Протокол = Форма.ТекстПротокола();
	Проверка("эмулятор доступен по сети", СтрНайти(Протокол, "1. Эмулятор: доступен по сети") > 0, Протокол);
	Проверка("сертификат доверенный", СтрНайти(Протокол, "2. Сертификат эмулятора на этом компьютере: доверенный") > 0, Протокол);
	Проверка("перезапуск не нужен (константы уже включены)", НуженПерезапуск = Ложь, Протокол);
	Проверка("прокси: константа сервера", НРег(ПроксиКонстанты()) = НРег(Компьютер + ":3128"), ПроксиКонстанты());
	Проверка("прокси: в протоколе", СтрНайти(Протокол, "4. Прокси-сервер: " + Компьютер + ":3128 (сервер 1С:Предприятия, пользователей: ") > 0, Протокол);
	Проверка("организация в эмуляторе", СтрНайти(Протокол, "зарегистрирована участником оборота") > 0, Протокол);
	Проверка("ключ сессии получен", СтрНайти(Протокол, """: получен. Подключение к эмулятору работает") > 0, Протокол);

	Форма.ПроверитьВыполнить();
	Протокол = Форма.ТекстПротокола();
	Проверка("проверка: HTTPS с клиента", СтрНайти(Протокол, "2. HTTPS к ГИС МТ через эмулятор с этого компьютера: работает") > 0, Протокол);
	Проверка("проверка: ключ сессии", СтрНайти(Протокол, """: получен") > 0, Протокол);

	Форма.Закрыть();

КонецПроцедуры

Процедура Выполнить_Автотест()

	тИтоги = Новый Массив;
	Параметры = СтрРазделить(ПараметрЗапуска, "|");
	ФайлРезультата = Параметры[0];

	Попытка
		ТестПодключения(Параметры[1], Параметры[2]);
	Исключение
		Проверка("исключение", Ложь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Ошибок = 0;
	Для Каждого Итог Из тИтоги Цикл
		Если СтрНачинаетсяС(Итог, "FAIL") Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	тИтоги.Добавить(СтрШаблон("ИТОГ: проверок %1, ошибок %2", тИтоги.Количество(), Ошибок));

	Запись = Новый ЗаписьТекста(ФайлРезультата, КодировкаТекста.UTF8);
	Запись.Записать(СтрСоединить(тИтоги, Символы.ПС));
	Запись.Закрыть();

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

Выполнить_Автотест();
