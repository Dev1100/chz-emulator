// Настройка базы на работу с эмулятором Честного Знака (chz-emulator).
// Только для тестовых баз: включает тестовый контур ИС МП, прокси на эмулятор, подключение к СУЗ.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресЭмулятора = "127.0.0.1";
	ПортЭмулятора  = 3128;
	АдресСУЗ       = "suz.sandbox.crptech.ru";
	ИдентификаторСУЗ = "emu-oms-0001";

	ВключитьТестовыйКонтур     = Истина;
	ВключитьУчетИСМП           = Истина;
	ЗарегистрироватьВЭмуляторе = Истина;
	НастроитьСУЗ               = Истина;

	Список = Элементы.ПроксиДля.СписокВыбора;
	Список.Добавить(ПроксиТекущемуПользователю());
	Список.Добавить(ПроксиВсемПользователям());
	Список.Добавить(ПроксиНаСервере());
	Список.Добавить(ПроксиНеНастраивать());
	ПроксиДля = ?(ОбщегоНазначения.ИнформационнаяБазаФайловая(), ПроксиВсемПользователям(), ПроксиНаСервере());

	Выборка = Справочники.Организации.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ПометкаУдаления И Не Выборка.ЭтоГруппа Тогда
			Организация = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьИНН();

	Протокол = ТекущееСостояние();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НастроитьОбработка(Команда)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите организацию.", , "Организация");
		Возврат;
	КонецЕсли;
	Если НастроитьСУЗ И Не ЗначениеЗаполнено(Подразделение) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Для подключения к СУЗ выберите подразделение — оно станет производственным объектом.", , "Подразделение");
		Возврат;
	КонецЕсли;

	НуженПерезапуск = НастроитьНаСервере();
	Если НуженПерезапуск Тогда
		ПоказатьПредупреждение(, "Настройки записаны. Перезапустите программу: учёт маркируемой продукции
			|и тестовый контур вступят в силу со следующего сеанса.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбработка(Команда)
	ПроверитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТестовымиДаннымиОбработка(Команда)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите организацию.", , "Организация");
		Возврат;
	КонецЕсли;
	ЗаполнитьТестовымиДаннымиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОбработка(Команда)

	Оповещение = Новый ОписаниеОповещения("ОтключитьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Выключить тестовый контур ИС МП и прокси на эмулятор?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОтключитьНаСервере();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	ЗаполнитьИНН();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИНН()
	ИНН = ?(ЗначениеЗаполнено(Организация), Организация.ИНН, "");
КонецПроцедуры

&НаСервере
Функция НастроитьНаСервере() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("%1 — настройка для «%2» (ИНН %3)", Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"), Организация, ИНН));
	НуженПерезапуск = Ложь;

	Если ВключитьУчетИСМП И Не Константы.ВестиУчетМаркируемойПродукцииИСМП.Получить() Тогда
		Константы.ВестиУчетМаркируемойПродукцииИСМП.Установить(Истина);
		НуженПерезапуск = Истина;
		Строки.Добавить("Учёт маркируемой продукции ИС МП: включён");
	КонецЕсли;

	Если ВключитьТестовыйКонтур И Не Константы.РежимРаботыСТестовымКонтуромИСМП.Получить() Тогда
		Константы.РежимРаботыСТестовымКонтуромИСМП.Установить(Истина);
		НуженПерезапуск = Истина;
		Строки.Добавить("Тестовый контур ИС МП: включён");
	КонецЕсли;

	Строки.Добавить("Прокси: " + ЗаписатьПрокси(Истина));

	Если ЗарегистрироватьВЭмуляторе Тогда
		Строки.Добавить("Эмулятор: " + ЗарегистрироватьОрганизациюВЭмуляторе());
	КонецЕсли;

	Если НастроитьСУЗ Тогда
		Строки.Добавить("СУЗ: " + ЗаписатьНастройкуСУЗ());
	КонецЕсли;

	Протокол = СтрСоединить(Строки, Символы.ПС) + Символы.ПС + Символы.ПС + ТекущееСостояние();
	Возврат НуженПерезапуск;

КонецФункции

&НаСервере
Процедура ОтключитьНаСервере()

	Константы.РежимРаботыСТестовымКонтуромИСМП.Установить(Ложь);
	Протокол = "Тестовый контур ИС МП: выключен" + Символы.ПС + "Прокси: " + ЗаписатьПрокси(Ложь)
		+ Символы.ПС + "Перезапустите программу." + Символы.ПС + Символы.ПС + ТекущееСостояние();

КонецПроцедуры

// Прокси хранится так же, как его пишет форма БСП «Параметры прокси-сервера»:
// файловая база — общие настройки пользователя, клиент-серверная — константа НастройкаПроксиСервера.
&НаСервере
Функция ЗаписатьПрокси(Использовать)

	Если ПроксиДля = ПроксиНеНастраивать() Тогда
		Возврат "не менялся";
	КонецЕсли;

	Настройка = Новый Соответствие;
	Настройка.Вставить("ИспользоватьПрокси",                      Использовать);
	Настройка.Вставить("ИспользоватьСистемныеНастройки",          Ложь);
	Настройка.Вставить("Сервер",                                  СокрЛП(АдресЭмулятора));
	Настройка.Вставить("Порт",                                    ПортЭмулятора);
	Настройка.Вставить("Пользователь",                            "");
	Настройка.Вставить("Пароль",                                  "");
	Настройка.Вставить("НеИспользоватьПроксиДляЛокальныхАдресов", Ложь);
	Настройка.Вставить("ИспользоватьАутентификациюОС",            Ложь);

	Действие = ?(Использовать, СтрШаблон("%1:%2", СокрЛП(АдресЭмулятора), Формат(ПортЭмулятора, "ЧГ=0")), "выключен");

	Если ПроксиДля = ПроксиНаСервере() Тогда
		УстановитьПривилегированныйРежим(Истина);
		Константы.НастройкаПроксиСервера.Установить(Новый ХранилищеЗначения(Настройка));
		Возврат Действие + " (на сервере 1С)";
	КонецЕсли;

	Если ПроксиДля = ПроксиВсемПользователям() Тогда
		Имена = Новый Массив;
		Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", Настройка, , ПользовательИБ.Имя);
			Имена.Добавить(ПользовательИБ.Имя);
		КонецЦикла;
		Если Имена.Количество() = 0 Тогда
			ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", Настройка);
			Имена.Добавить("<без пользователей>");
		КонецЕсли;
		Возврат Действие + " (пользователи: " + СтрСоединить(Имена, ", ") + ")";
	КонецЕсли;

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", Настройка);
	Возврат Действие + " (текущий пользователь)";

КонецФункции

&НаСервере
Функция ЗаписатьНастройкуСУЗ()

	Станция = Справочники.СтанцииУправленияЗаказамиИСМП.НайтиПоРеквизиту("Идентификатор", СокрЛП(ИдентификаторСУЗ));
	Если Станция.Пустая() Тогда
		НоваяСтанция = Справочники.СтанцииУправленияЗаказамиИСМП.СоздатьЭлемент();
		НоваяСтанция.Наименование  = "Эмулятор ЧЗ (" + СокрЛП(ИдентификаторСУЗ) + ")";
		НоваяСтанция.Идентификатор = СокрЛП(ИдентификаторСУЗ);
		НоваяСтанция.ФорматОбмена  = Перечисления.ВерсииФорматаОбменаСУЗ.V3;
		НоваяСтанция.Записать();
		Станция = НоваяСтанция.Ссылка;
	КонецЕсли;

	Запись = РегистрыСведений.НастройкиОбменаСУЗ.СоздатьМенеджерЗаписи();
	Запись.Организация               = Организация;
	Запись.СтанцияУправленияЗаказами = Станция;
	Запись.ПроизводственныйОбъект    = Подразделение;
	Запись.Прочитать();

	Запись.Организация               = Организация;
	Запись.СтанцияУправленияЗаказами = Станция;
	Запись.ПроизводственныйОбъект    = Подразделение;
	Запись.Адрес                     = СокрЛП(АдресСУЗ);
	Запись.Порт                      = 443;
	Запись.Таймаут                   = 60;
	Запись.ИспользоватьЗащищенноеСоединение = Истина;
	Запись.ОбменНаСервере            = Истина;
	Если Запись.ПолучатьКодовЗаИтерацию = 0 Тогда
		Запись.ПолучатьКодовЗаИтерацию = 1000;
	КонецЕсли;
	Если Запись.МаксимальноеКоличествоКодовВЗаказе = 0 Тогда
		Запись.МаксимальноеКоличествоКодовВЗаказе = 150000;
	КонецЕсли;
	// Идентификатор соединения в ЧЗ выдаётся при регистрации рабочего места; эмулятор примет любой.
	Если Не ЗначениеЗаполнено(Запись.ИдентификаторСоединения) Тогда
		Запись.ИдентификаторСоединения = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Запись.ПроизводственныйОбъектАдресСтрокой) Тогда
		Запись.ПроизводственныйОбъектАдресСтрокой = "Адрес МОД (эмулятор ЧЗ)";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Запись.КодФИАС) Тогда
		Запись.КодФИАС = Новый УникальныйИдентификатор;
	КонецЕсли;
	Запись.Записать();

	Возврат СтрШаблон("станция «%1», %2:443, производственный объект «%3»", Станция, Запись.Адрес, Подразделение);

КонецФункции

// Участник оборота в эмуляторе: админ-API эмулятора, напрямую, без прокси.
&НаСервере
Функция ЗарегистрироватьОрганизациюВЭмуляторе()

	Данные = Новый Структура("inn, name, status", ИНН, Строка(Организация), "REGISTERED");
	Результат = ЗапросКЭмулятору("POST", "/_emu/participant", Данные);
	Если Результат.Успех Тогда
		ЗапросКЭмулятору("POST", "/_emu/settings", Новый Структура("default_inn", ИНН));
		Возврат "организация зарегистрирована участником, ИНН по умолчанию " + ИНН;
	КонецЕсли;
	Возврат "не удалось — " + Результат.Текст;

КонецФункции

&НаСервере
Функция ЗапросКЭмулятору(Метод, Адрес, Данные = Неопределено)

	Результат = Новый Структура("Успех, Код, Текст", Ложь, 0, "");
	Попытка
		Соединение = Новый HTTPСоединение(СокрЛП(АдресЭмулятора), ПортЭмулятора, , , , 10);
		Запрос = Новый HTTPЗапрос(Адрес);
		Если Данные <> Неопределено Тогда
			Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			Запись = Новый ЗаписьJSON;
			Запись.УстановитьСтроку();
			ЗаписатьJSON(Запись, Данные);
			Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
		Результат.Код   = Ответ.КодСостояния;
		Результат.Текст = Ответ.ПолучитьТелоКакСтроку();
		Результат.Успех = Ответ.КодСостояния = 200;
	Исключение
		Результат.Текст = СтрШаблон("эмулятор %1:%2 недоступен (%3)", АдресЭмулятора, Формат(ПортЭмулятора, "ЧГ=0"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПроверитьНаСервере() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + " — проверка связи");

	Р = ЗапросКЭмулятору("GET", "/_emu/state?limit=1");
	Строки.Добавить("1. Эмулятор " + ?(Р.Успех, "запущен (" + АдресЭмулятора + ":" + Формат(ПортЭмулятора, "ЧГ=0") + ")", "НЕ ОТВЕЧАЕТ: " + Р.Текст));

	// Тем же путём, что и типовая: прокси из настроек БСП, HTTPS с проверкой сертификата по хранилищу Windows.
	ПараметрыHTTP = ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ПараметрыОтправкиHTTPЗапросов(Неопределено, Истина);
	Адрес = "api/v3/true-api/auth/key";
	Ответ = ОбменДаннымиИСМПКлиентСервер.ОбработатьРезультатОтправкиHTTPЗапросаКакJSON(
		ОбщегоНазначенияИСМП.ПолучитьДанныеИзСервиса(Адрес, Неопределено, ПараметрыHTTP));
	Если Ответ.ОтветПолучен И Ответ.КодСостояния = 200 Тогда
		Строки.Добавить("2. ГИС МТ (" + ПараметрыHTTP.Сервер + ") через прокси по HTTPS: OK — сертификат эмулятора доверен");
	Иначе
		Строки.Добавить("2. ГИС МТ (" + ПараметрыHTTP.Сервер + "): ОШИБКА — "
			+ ОбщегоНазначенияИСКлиентСервер.ТекстОшибкиПоРезультатуОтправкиЗапроса(Адрес, Ответ)
			+ Символы.ПС + "   Проверьте прокси, что эмулятор запущен и что его корневой сертификат (ca.crt) в доверенных.");
	КонецЕсли;

	Если ЗначениеЗаполнено(Организация) Тогда
		Ключ = ИнтерфейсАвторизацииИСМПСлужебный.ПроверитьОбновитьКлючСессии(
			ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ПараметрыЗапросаКлючаСессии(Организация));
		Строки.Добавить("3. Токен ГИС МТ для «" + Организация + "»: " + ?(Ключ = Неопределено,
			"не получен — нужна ЭП организации или расширение «ЧЗ: без подписи»", "получен"));

		НастройкиСУЗ = ИнтеграцияИСМП.НастройкиОбменаСУЗ(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация));
		Строки.Добавить("4. Подключение к СУЗ: " + ?(НастройкиСУЗ.БезНастроек.Найти(Организация) = Неопределено,
			"настроено", "НЕ настроено (кнопка «Настроить» с флажком СУЗ)"));
	КонецЕсли;

	Протокол = СтрСоединить(Строки, Символы.ПС) + Символы.ПС + Символы.ПС + ТекущееСостояние();

КонецПроцедуры

// Тестовые данные: в 1С — склад, вид номенклатуры, маркируемые товары с видом продукции ИС, GTIN и ТН ВЭД,
// поставщик и покупатель; в эмуляторе — участники, карточки Нац. каталога и коды в разных состояниях.
// Повторный запуск ничего не дублирует: существующие объекты и коды переиспользуются.
&НаСервере
Процедура ЗаполнитьТестовымиДаннымиНаСервере() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + " — тестовые данные для «" + Организация + "» (ИНН " + ИНН + ")");
	ИННПоставщика = "7700000002";
	ИННПокупателя = "7700000003";

	// ---- 1С
	Шт = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("шт", Истина);
	Склад = Справочники.Склады.НайтиПоНаименованию("Склад ЧЗ (тест)", Истина);
	Если Склад.Пустая() Тогда
		НовыйСклад = Справочники.Склады.СоздатьЭлемент();
		НовыйСклад.Наименование = "Склад ЧЗ (тест)";
		НовыйСклад.ТипСклада = Перечисления.ТипыСкладов.ОптовыйСклад;
		НовыйСклад.ОбменДанными.Загрузка = Истина;
		НовыйСклад.Записать();
		Склад = НовыйСклад.Ссылка;
	КонецЕсли;
	ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Маркируемый товар (ЧЗ тест)", Истина);
	Если ВидНоменклатуры.Пустая() Тогда
		НовыйВид = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
		НовыйВид.Наименование = "Маркируемый товар (ЧЗ тест)";
		НовыйВид.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
		НовыйВид.ЕдиницаИзмерения = Шт;
		НовыйВид.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
		НовыйВид.ОбменДанными.Загрузка = Истина;
		НовыйВид.Записать();
		ВидНоменклатуры = НовыйВид.Ссылка;
	КонецЕсли;
	Строки.Добавить("Склад: " + Склад + "; вид номенклатуры: " + ВидНоменклатуры);

	Товары = ТестовыеТовары();
	Для Каждого Товар Из Товары Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыПродукцииИС
			|ГДЕ Наименование ПОДОБНО &Шаблон И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Наименование");
		Запрос.УстановитьПараметр("Шаблон", Товар.ШаблонВида);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Строки.Добавить("! " + Товар.Наименование + ": в классификаторе нет вида продукции «" + Товар.ШаблонВида
				+ "» — загрузите классификатор видов продукции ИС");
			Товар.Пропустить = Истина;
			Продолжить;
		КонецЕсли;
		Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Товар.Наименование, Истина);
		ОбъектНоменклатуры = ?(Номенклатура.Пустая(), Справочники.Номенклатура.СоздатьЭлемент(), Номенклатура.ПолучитьОбъект());
		ОбъектНоменклатуры.Наименование       = Товар.Наименование;
		ОбъектНоменклатуры.НаименованиеПолное = Товар.Наименование;
		ОбъектНоменклатуры.Артикул            = "ЧЗ-" + Товар.ТоварнаяГруппа;
		ОбъектНоменклатуры.ВидНоменклатуры    = ВидНоменклатуры;
		ОбъектНоменклатуры.ТипНоменклатуры    = Перечисления.ТипыНоменклатуры.Товар;
		ОбъектНоменклатуры.ЕдиницаИзмерения   = Шт;
		ОбъектНоменклатуры.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
		ОбъектНоменклатуры.КодТНВЭД           = КодТНВЭД(Товар.ТНВЭД, Товар.Наименование);
		ОбъектНоменклатуры.ОбменДанными.Загрузка = Истина;
		ОбъектНоменклатуры.Записать();

		ПоляКлюча = Справочники.КлючиВидовПродукцииИС.ПоляКлюча();
		ПоляКлюча.ВидПродукцииГИСМТ = Выборка.Ссылка;
		Описание = ОбщегоНазначенияИС.ИнициализироватьДанныеОписанияНоменклатуры();
		Описание.Номенклатура       = ОбъектНоменклатуры.Ссылка;
		Описание.КлючВидовПродукции = Справочники.КлючиВидовПродукцииИС.ПолучитьКлюч(ПоляКлюча);
		РегистрыСведений.ОписаниеНоменклатурыИС.УстановитьОписание(Описание);

		Штрихкод = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		Штрихкод.Штрихкод     = Сред(Товар.GTIN, 2);
		Штрихкод.Номенклатура = ОбъектНоменклатуры.Ссылка;
		Штрихкод.Записать(Истина);
		Строки.Добавить(СтрШаблон("Товар: %1 | %2 | штрихкод %3 | ТН ВЭД %4", ОбъектНоменклатуры.Ссылка, Выборка.Ссылка,
			Штрихкод.Штрихкод, Товар.ТНВЭД));
	КонецЦикла;

	Строки.Добавить("Поставщик: " + ТестовыйКонтрагент(ИННПоставщика, "ООО Поставщик ЧЗ", Ложь));
	Строки.Добавить("Покупатель: " + ТестовыйКонтрагент(ИННПокупателя, "ООО Покупатель ЧЗ", Истина));

	// ---- эмулятор
	Проверка = ЗапросКЭмулятору("GET", "/_emu/state?limit=1");
	Если Не Проверка.Успех Тогда
		Строки.Добавить("Эмулятор: " + Проверка.Текст + " — коды и карточки НК не созданы");
	Иначе
		ЗапросКЭмулятору("POST", "/_emu/settings", Новый Структура("default_inn", ИНН));
		ЗапросКЭмулятору("POST", "/_emu/participant", Новый Структура("inn, name", ИНН, Строка(Организация)));
		ЗапросКЭмулятору("POST", "/_emu/participant", Новый Структура("inn, name", ИННПоставщика, "ООО Поставщик ЧЗ"));
		ЗапросКЭмулятору("POST", "/_emu/participant", Новый Структура("inn, name", ИННПокупателя, "ООО Покупатель ЧЗ"));
		Для Каждого Товар Из Товары Цикл
			Если Товар.Пропустить Тогда
				Продолжить;
			КонецЕсли;
			ЗапросКЭмулятору("POST", "/_emu/nk", Новый Структура("gtin, name, pg, inn, tnved, brand, status",
				Товар.GTIN, Товар.Наименование, Товар.ТоварнаяГруппа, ИНН, Товар.ТНВЭД, "ТЕСТ", "published"));
			Строки.Добавить(Товар.Наименование + " (" + Товар.GTIN + "):");
			Строки.Добавить("   в обороте: " + КодыВЭмуляторе(Товар, ИНН, "INTRODUCED", 5, Ложь));
			Строки.Добавить("   нанесены (под ввод в оборот): " + КодыВЭмуляторе(Товар, ИНН, "APPLIED", 3, Ложь));
			Строки.Добавить("   в коробке: " + КодыВЭмуляторе(Товар, ИНН, "INTRODUCED", 3, Истина));
			Строки.Добавить("   входящая отгрузка от поставщика: " + ВходящаяОтгрузка(Товар, ИННПоставщика));
		КонецЦикла;
	КонецЕсли;

	Строки.Добавить("Коды целиком (с GS, как со сканера) — в эмуляторе, вкладка «Коды», кнопка «⧉ полный».");
	Протокол = СтрСоединить(Строки, Символы.ПС);

КонецПроцедуры

&НаСервере
Функция ТестовыеТовары()

	Товары = Новый Массив;
	// Наименование, ТГ эмулятора, ТН ВЭД, шаблон вида продукции ИС, номер для GTIN 04607777000NN
	Для Каждого Описание Из СтрРазделить(
		"Ботинки мужские тестовые ЧЗ;shoes;6403990000;%Обувн%;1|"
		+ "Футболка хлопковая тестовая ЧЗ;lp;6109100000;Одежда;2|"
		+ "Вода питьевая 0,5 л тестовая ЧЗ;water;2201101100;%Питьевая вода%;3|"
		+ "Туалетная вода тестовая ЧЗ;chemistry;3303009000;Парфюмерия;4", "|") Цикл
		Части = СтрРазделить(Описание, ";");
		Тело = "46077770000" + Части[4];
		Товар = Новый Структура("Наименование, ТоварнаяГруппа, ТНВЭД, ШаблонВида, GTIN, Пропустить",
			Части[0], Части[1], Части[2], Части[3], "0" + Тело + КонтрольнаяЦифраGTIN(Тело), Ложь);
		Товары.Добавить(Товар);
	КонецЦикла;
	Возврат Товары;

КонецФункции

&НаСервереБезКонтекста
Функция КонтрольнаяЦифраGTIN(Тело)
	Сумма = 0;
	Вес = 3;
	Для Индекс = 0 По СтрДлина(Тело) - 1 Цикл
		Сумма = Сумма + Число(Сред(Тело, СтрДлина(Тело) - Индекс, 1)) * Вес;
		Вес = 4 - Вес;
	КонецЦикла;
	Возврат Строка((10 - Сумма % 10) % 10);
КонецФункции

&НаСервереБезКонтекста
Функция КодТНВЭД(Код, Наименование)
	Ссылка = Справочники.КлассификаторТНВЭД.НайтиПоКоду(Код);
	Если Ссылка.Пустая() Тогда
		Элемент = Справочники.КлассификаторТНВЭД.СоздатьЭлемент();
		Элемент.Код = Код;
		Элемент.Наименование = Наименование;
		Элемент.ОбменДанными.Загрузка = Истина;
		Элемент.Записать();
		Ссылка = Элемент.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция ТестовыйКонтрагент(ИННКонтрагента, Наименование, ЭтоКлиент)

	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИННКонтрагента);
	Если Контрагент.Пустая() Тогда
		Партнер = Справочники.Партнеры.СоздатьЭлемент();
		Партнер.Наименование       = Наименование;
		Партнер.НаименованиеПолное = Наименование;
		Партнер.Клиент             = ЭтоКлиент;
		Партнер.Поставщик          = Не ЭтоКлиент;
		Партнер.ЮрФизЛицо          = Перечисления.КомпанияЧастноеЛицо.Компания;
		Партнер.ДатаРегистрации    = ТекущаяДатаСеанса();
		Партнер.ОбменДанными.Загрузка = Истина;
		Партнер.Записать();
		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйКонтрагент.Наименование       = Наименование;
		НовыйКонтрагент.НаименованиеПолное = Наименование;
		НовыйКонтрагент.ИНН                = ИННКонтрагента;
		НовыйКонтрагент.КПП                = "770001001";
		НовыйКонтрагент.Партнер            = Партнер.Ссылка;
		НовыйКонтрагент.ЮрФизЛицо          = Перечисления.ЮрФизЛицо.ЮрЛицо;
		НовыйКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
		НовыйКонтрагент.ОбменДанными.Загрузка = Истина;
		НовыйКонтрагент.Записать();
		Контрагент = НовыйКонтрагент.Ссылка;
	КонецЕсли;
	Возврат Строка(Контрагент) + " (ИНН " + ИННКонтрагента + ")";

КонецФункции

// Коды в эмуляторе: если подходящие по GTIN/статусу/владельцу уже есть — используются они, иначе создаются.
&НаСервере
Функция КодыВЭмуляторе(Товар, Владелец, Статус, Количество, ВКоробке)

	Есть = 0;
	Ответ = ЗапросКЭмулятору("GET", "/_emu/state?limit=5000&q=" + Товар.GTIN);
	Данные = ?(Ответ.Успех, ПрочитатьОтветJSON(Ответ.Текст), Неопределено);
	Если Данные <> Неопределено Тогда
		Для Каждого Код Из Данные["codes"] Цикл
			Если Код["gtin"] = Товар.GTIN И Код["status"] = Статус И Код["owner_inn"] = Владелец
				И ЗначениеЗаполнено(Код["parent"]) = ВКоробке И Код["package_type"] = "UNIT" Тогда
				Есть = Есть + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Есть >= Количество Тогда
		Возврат СтрШаблон("%1 (уже были)", Есть);
	КонецЕсли;
	ПараметрыКодов = Новый Структура("gtin, pg, name, tnved, owner_inn, count, status, aggregate",
		Товар.GTIN, Товар.ТоварнаяГруппа, Товар.Наименование, Товар.ТНВЭД, Владелец, Количество - Есть, Статус, ВКоробке);
	Ответ = ЗапросКЭмулятору("POST", "/_emu/codes", ПараметрыКодов);
	Если Не Ответ.Успех Тогда
		Возврат "ошибка: " + Ответ.Текст;
	КонецЕсли;
	Данные = ПрочитатьОтветJSON(Ответ.Текст);
	Возврат СтрШаблон("%1 создано%2", Количество - Есть,
		?(ВКоробке И Данные <> Неопределено, ", коробка " + Данные["box"], ""));

КонецФункции

&НаСервере
Функция ВходящаяОтгрузка(Товар, ИННПоставщика)

	Ответ = ЗапросКЭмулятору("GET", "/_emu/state?limit=5000&q=" + Товар.GTIN);
	Данные = ?(Ответ.Успех, ПрочитатьОтветJSON(Ответ.Текст), Неопределено);
	Если Данные <> Неопределено Тогда
		Для Каждого Код Из Данные["codes"] Цикл
			Если Код["gtin"] = Товар.GTIN И Код["owner_inn"] = ИННПоставщика Тогда
				Возврат "уже есть (коды у поставщика " + ИННПоставщика + ")";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Ответ = ЗапросКЭмулятору("POST", "/_emu/incoming", Новый Структура("sender_inn, receiver_inn, gtin, pg, count",
		ИННПоставщика, ИНН, Товар.GTIN, Товар.ТоварнаяГруппа, 4));
	Данные = ?(Ответ.Успех, ПрочитатьОтветJSON(Ответ.Текст), Неопределено);
	Возврат ?(Данные = Неопределено, "ошибка: " + Ответ.Текст, "документ " + Данные["number"] + ", кодов 4 (примите его в 1С)");

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьОтветJSON(Текст)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Возврат ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ТекущееСостояние()

	Строки = Новый Массив;
	Строки.Добавить("Состояние базы:");
	Строки.Добавить("  тестовый контур ИС МП — " + ДаНет(Константы.РежимРаботыСТестовымКонтуромИСМП.Получить()));
	Строки.Добавить("  учёт маркируемой продукции ИС МП — " + ДаНет(Константы.ВестиУчетМаркируемойПродукцииИСМП.Получить()));

	Прокси = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкаПроксиСервера", "");
	Строки.Добавить("  прокси текущего пользователя — " + ОписаниеПрокси(Прокси));
	УстановитьПривилегированныйРежим(Истина);
	Строки.Добавить("  прокси на сервере 1С — " + ОписаниеПрокси(Константы.НастройкаПроксиСервера.Получить().Получить()));
	УстановитьПривилегированныйРежим(Ложь);

	Расширения = РасширенияКонфигурации.Получить(Новый Структура("Имя", "ЧЗ_БезПодписи"));
	Строки.Добавить("  расширение «ЧЗ: без подписи» — " + ?(Расширения.Количество() = 0, "не установлено",
		"установлено" + ?(Расширения[0].БезопасныйРежим = Истина, ", НО включён безопасный режим — снимите флажок", "")));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеПрокси(Настройка)
	Если ТипЗнч(Настройка) <> Тип("Соответствие") Или Настройка.Получить("ИспользоватьПрокси") <> Истина Тогда
		Возврат "не используется";
	ИначеЕсли Настройка.Получить("ИспользоватьСистемныеНастройки") = Истина Тогда
		Возврат "системные настройки";
	КонецЕсли;
	Возврат СтрШаблон("%1:%2", Настройка.Получить("Сервер"), Формат(Настройка.Получить("Порт"), "ЧГ=0"));
КонецФункции

&НаСервереБезКонтекста
Функция ДаНет(Значение)
	Возврат ?(Значение = Истина, "да", "нет");
КонецФункции

