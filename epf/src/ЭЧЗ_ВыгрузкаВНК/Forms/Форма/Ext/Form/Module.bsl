// Выгрузка GTIN номенклатуры в Национальный каталог эмулятора ЧЗ (chz-emulator, админ-API /_emu/nk/import).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресЭмулятора    = "127.0.0.1";
	ПортЭмулятора     = 3128;
	ТолькоМаркируемые = Истина;

	Элементы.СтатусКарточки.СписокВыбора.Добавить(СтатусОпубликована());
	Элементы.СтатусКарточки.СписокВыбора.Добавить(СтатусОжидаетПодписи());
	СтатусКарточки = СтатусОпубликована();

	Выборка = Справочники.Организации.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ПометкаУдаления И Не Выборка.ЭтоГруппа Тогда
			Организация = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьОбработка(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОбработка(Команда)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите организацию: её ИНН станет ИНН производителя в карточках.", , "Организация");
		Возврат;
	КонецЕсли;
	ВыгрузитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеОбработка(Команда)
	Для Каждого СтрокаТоваров Из Товары Цикл
		СтрокаТоваров.Выгрузить = Не ЗначениеЗаполнено(СтрокаТоваров.Проблема);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеОбработка(Команда)
	Для Каждого СтрокаТоваров Из Товары Цикл
		СтрокаТоваров.Выгрузить = Ложь;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере() Экспорт

	Товары.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Номенклатура КАК Номенклатура,
	|	Штрихкоды.Номенклатура.Наименование КАК Наименование,
	|	&ПолеТНВЭД КАК ТНВЭД,
	|	ОписаниеИС.КлючВидовПродукции КАК КлючВидовПродукции
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеИС
	|		ПО (ОписаниеИС.Номенклатура = Штрихкоды.Номенклатура)
	|ГДЕ
	|	НЕ Штрихкоды.Номенклатура.ПометкаУдаления
	|	И (НЕ &ТолькоМаркируемые
	|			ИЛИ НЕ ОписаниеИС.КлючВидовПродукции ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование,
	|	Штрихкод";
	// ТН ВЭД у номенклатуры есть не во всех конфигурациях (в Рознице 3.0 / УНФ реквизита КодТНВЭД нет)
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("КодТНВЭД") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеТНВЭД", "Штрихкоды.Номенклатура.КодТНВЭД.Код");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеТНВЭД", """""");
	КонецЕсли;
	Запрос.УстановитьПараметр("ТолькоМаркируемые", ТолькоМаркируемые);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Вид = Неопределено;
		Если ЗначениеЗаполнено(Выборка.КлючВидовПродукции) Тогда
			Вид = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииКлючаПоПодсистеме(Выборка.КлючВидовПродукции, "ГИСМТ");
		КонецЕсли;
		Если ЗначениеЗаполнено(ВидПродукции) И Вид <> ВидПродукции Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТоваров = Товары.Добавить();
		СтрокаТоваров.Номенклатура = Выборка.Номенклатура;
		СтрокаТоваров.Штрихкод     = СокрЛП(Выборка.Штрихкод);
		СтрокаТоваров.Наименование = Выборка.Наименование;
		СтрокаТоваров.ТНВЭД        = Выборка.ТНВЭД;
		Если ЗначениеЗаполнено(Вид) Тогда
			СтрокаТоваров.ВидПродукции = Вид;
			Попытка
				СтрокаТоваров.ТоварнаяГруппа = ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ТоварнаяГруппа(Вид);
			Исключение
				СтрокаТоваров.ТоварнаяГруппа = "";
			КонецПопытки;
		КонецЕсли;

		СтрокаТоваров.Проблема = ПроблемаШтрихкода(СтрокаТоваров.Штрихкод);
		Если Не ЗначениеЗаполнено(СтрокаТоваров.Проблема) Тогда
			СтрокаТоваров.GTIN = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(СтрокаТоваров.Штрихкод);
			Если Не ЗначениеЗаполнено(СтрокаТоваров.ТоварнаяГруппа) Тогда
				СтрокаТоваров.Проблема = "не задан вид продукции ИС (описание номенклатуры ИС)";
			КонецЕсли;
		КонецЕсли;
		СтрокаТоваров.Выгрузить = Не ЗначениеЗаполнено(СтрокаТоваров.Проблема);

	КонецЦикла;

	Ошибок = Товары.НайтиСтроки(Новый Структура("Выгрузить", Ложь)).Количество();
	Протокол = СтрШаблон("Найдено штрихкодов: %1, к выгрузке: %2, с проблемами: %3.",
		Товары.Количество(), Товары.Количество() - Ошибок, Ошибок);

КонецПроцедуры

// GTIN: только цифры, длина 8/12/13/14, верная контрольная цифра, не внутренний штрихкод (13 знаков на «2»).
&НаСервереБезКонтекста
Функция ПроблемаШтрихкода(Знач Штрихкод)

	Если СтрДлина(Штрихкод) = 0 Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Штрихкод) Тогда
		Возврат "не GTIN: в штрихкоде не только цифры";
	КонецЕсли;
	Длина = СтрДлина(Штрихкод);
	Если Длина <> 8 И Длина <> 12 И Длина <> 13 И Длина <> 14 Тогда
		Возврат СтрШаблон("не GTIN: длина %1 (нужно 8, 12, 13 или 14)", Длина);
	КонецЕсли;
	Если Не МенеджерОборудованияКлиентСервер.ПроверитьКорректностьGTIN(Штрихкод) Тогда
		Тело = Лев(Штрихкод, Длина - 1);
		Возврат СтрШаблон("неверная контрольная цифра: должно быть %1%2", Тело, КонтрольнаяЦифра(Тело));
	КонецЕсли;
	EAN = Прав("00000000000000" + Штрихкод, 13);
	Если Лев(EAN, 1) = "2" Тогда
		Возврат "внутренний штрихкод (начинается с «2») — для маркировки нужен GTIN";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция КонтрольнаяЦифра(Тело)
	Сумма = 0;
	Вес = 3;
	Для Индекс = 0 По СтрДлина(Тело) - 1 Цикл
		Сумма = Сумма + Число(Сред(Тело, СтрДлина(Тело) - Индекс, 1)) * Вес;
		Вес = 4 - Вес;
	КонецЦикла;
	Возврат Строка((10 - Сумма % 10) % 10);
КонецФункции

&НаСервере
Процедура ВыгрузитьНаСервере() Экспорт

	ИНН = Организация.ИНН;
	Статус = ?(СтатусКарточки = СтатусОжидаетПодписи(), "notsigned", "published");
	Строки = Новый Массив;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Если СтрокаТоваров.Выгрузить И Не ЗначениеЗаполнено(СтрокаТоваров.Проблема) Тогда
			// GTIN;Наименование;ТГ;ТН ВЭД;Бренд;ИНН;Статус — формат импорта эмулятора
			Строки.Добавить(СтрокаТоваров.GTIN + ";" + СтрЗаменить(СтрокаТоваров.Наименование, ";", ",") + ";"
				+ СтрокаТоваров.ТоварнаяГруппа + ";" + СтрокаТоваров.ТНВЭД + ";;" + ИНН + ";" + Статус);
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Протокол = "Нечего выгружать: отметьте строки без проблем («Заполнить», затем «Отметить все без ошибок»).";
		Возврат;
	КонецЕсли;

	Результат = ЗапросКЭмулятору("/_emu/nk/import", Новый Структура("csv", СтрСоединить(Строки, Символы.ПС)));
	Если Результат.Успех Тогда
		Ответ = ПрочитатьОтвет(Результат.Текст);
		Протокол = СтрШаблон("Выгружено в Нац. каталог эмулятора: %1 карточек (статус «%2», ИНН %3).",
			?(Ответ = Неопределено, Строки.Количество(), Ответ["imported"]), СтатусКарточки, ИНН);
	Иначе
		Протокол = "Не удалось выгрузить: " + Результат.Текст;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗапросКЭмулятору(Адрес, Данные)

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Попытка
		Соединение = Новый HTTPСоединение(СокрЛП(АдресЭмулятора), ПортЭмулятора, , , Новый ИнтернетПрокси(Ложь), 30); // к эмулятору — напрямую, мимо прокси
		Запрос = Новый HTTPЗапрос(Адрес);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Данные);
		Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Результат.Текст = Ответ.ПолучитьТелоКакСтроку();
		Результат.Успех = Ответ.КодСостояния = 200;
	Исключение
		Результат.Текст = СтрШаблон("эмулятор %1:%2 недоступен (%3)", АдресЭмулятора, Формат(ПортЭмулятора, "ЧГ=0"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьОтвет(Текст)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Возврат ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтатусОпубликована()
	Возврат "Опубликована";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтатусОжидаетПодписи()
	Возврат "Ожидает подписи";
КонецФункции

#КонецОбласти
