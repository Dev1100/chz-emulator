{
  "title": "Настройка подключения к эмулятору ЧЗ",
  "properties": {
    "autoTitle": false
  },
  "events": {
    "OnCreateAtServer": "ПриСозданииНаСервере"
  },
  "elements": [
    {
      "label": "Пояснение",
      "title": "Настраивает базу на работу с эмулятором Честного Знака: тестовый контур ИС МП, прокси-сервер, подключение к СУЗ для выбранной организации; заполняет тестовыми данными (товары с GTIN и видом продукции, контрагенты, коды в эмуляторе). Для рабочих баз не применять."
    },
    {
      "group": "vertical",
      "name": "ГруппаОрганизация",
      "title": "Организация",
      "showTitle": true,
      "children": [
        {
          "input": "Организация",
          "path": "Организация",
          "markIncomplete": true,
          "horizontalStretch": true,
          "on": [
            "OnChange"
          ]
        },
        {
          "input": "Подразделение",
          "path": "Подразделение",
          "title": "Подразделение (производственный объект СУЗ)",
          "horizontalStretch": true
        },
        {
          "labelField": "ИНН",
          "path": "ИНН",
          "title": "ИНН"
        }
      ]
    },
    {
      "group": "vertical",
      "name": "ГруппаЭмулятор",
      "title": "Эмулятор и прокси",
      "showTitle": true,
      "children": [
        {
          "group": "horizontal",
          "name": "ГруппаАдрес",
          "children": [
            {
              "input": "АдресЭмулятора",
              "path": "АдресЭмулятора",
              "title": "Адрес эмулятора",
              "width": 20,
              "autoMaxWidth": false
            },
            {
              "input": "ПортЭмулятора",
              "path": "ПортЭмулятора",
              "title": "Порт",
              "width": 7,
              "autoMaxWidth": false
            }
          ]
        },
        {
          "input": "ПроксиДля",
          "path": "ПроксиДля",
          "title": "Прокси настроить",
          "dropListButton": true,
          "horizontalStretch": true
        },
        {
          "check": "ВключитьТестовыйКонтур",
          "path": "ВключитьТестовыйКонтур",
          "title": "Включить тестовый контур ИС МП"
        },
        {
          "check": "ВключитьУчетИСМП",
          "path": "ВключитьУчетИСМП",
          "title": "Включить учёт маркируемой продукции ИС МП"
        },
        {
          "check": "ЗарегистрироватьВЭмуляторе",
          "path": "ЗарегистрироватьВЭмуляторе",
          "title": "Зарегистрировать организацию участником оборота в эмуляторе"
        }
      ]
    },
    {
      "group": "vertical",
      "name": "ГруппаСУЗ",
      "title": "Станция управления заказами (СУЗ)",
      "showTitle": true,
      "children": [
        {
          "check": "НастроитьСУЗ",
          "path": "НастроитьСУЗ",
          "title": "Настроить подключение к СУЗ для организации"
        },
        {
          "group": "horizontal",
          "name": "ГруппаСУЗПараметры",
          "children": [
            {
              "input": "АдресСУЗ",
              "path": "АдресСУЗ",
              "title": "Адрес СУЗ",
              "width": 26,
              "autoMaxWidth": false
            },
            {
              "input": "ИдентификаторСУЗ",
              "path": "ИдентификаторСУЗ",
              "title": "Идентификатор СУЗ (omsId)",
              "width": 26,
              "autoMaxWidth": false
            }
          ]
        }
      ]
    },
    {
      "group": "horizontal",
      "name": "ГруппаКнопки",
      "children": [
        {
          "button": "Настроить",
          "command": "Настроить",
          "defaultButton": true,
          "title": "Настроить"
        },
        {
          "button": "Проверить",
          "command": "Проверить",
          "title": "Проверить связь"
        },
        {
          "button": "ЗаполнитьТестовымиДанными",
          "command": "ЗаполнитьТестовымиДанными",
          "title": "Заполнить тестовыми данными"
        },
        {
          "button": "Отключить",
          "command": "Отключить",
          "title": "Отключить эмулятор"
        }
      ]
    },
    {
      "input": "Протокол",
      "path": "Протокол",
      "title": "Протокол",
      "titleLocation": "top",
      "multiLine": true,
      "height": 10,
      "readOnly": true,
      "horizontalStretch": true
    }
  ],
  "attributes": [
    {
      "name": "Объект",
      "type": "ExternalDataProcessorObject.ЭЧЗ_НастройкаПодключения",
      "main": true
    },
    {
      "name": "Организация",
      "type": "CatalogRef.Организации"
    },
    {
      "name": "Подразделение",
      "type": "CatalogRef.СтруктураПредприятия"
    },
    {
      "name": "ИНН",
      "type": "string(12)"
    },
    {
      "name": "АдресЭмулятора",
      "type": "string(100)"
    },
    {
      "name": "ПортЭмулятора",
      "type": "decimal(5,0,nonneg)"
    },
    {
      "name": "ПроксиДля",
      "type": "string(100)"
    },
    {
      "name": "ВключитьТестовыйКонтур",
      "type": "boolean"
    },
    {
      "name": "ВключитьУчетИСМП",
      "type": "boolean"
    },
    {
      "name": "ЗарегистрироватьВЭмуляторе",
      "type": "boolean"
    },
    {
      "name": "НастроитьСУЗ",
      "type": "boolean"
    },
    {
      "name": "АдресСУЗ",
      "type": "string(100)"
    },
    {
      "name": "ИдентификаторСУЗ",
      "type": "string(50)"
    },
    {
      "name": "Протокол",
      "type": "string"
    }
  ],
  "commands": [
    {
      "name": "Настроить",
      "action": "НастроитьОбработка"
    },
    {
      "name": "Проверить",
      "action": "ПроверитьОбработка"
    },
    {
      "name": "Отключить",
      "action": "ОтключитьОбработка"
    },
    {
      "name": "ЗаполнитьТестовымиДанными",
      "action": "ЗаполнитьТестовымиДаннымиОбработка"
    }
  ]
}